{
  "_comment": "Renomme en maintctl-config.json. driversDir est un dossier (NFS/SMB monté localement sur le serveur MC, ou local) qui contient des packs pilotes au format .zip — chaque .zip est un pack autonome (un ou plusieurs .inf + fichiers associés). Le plugin scanne ce dossier et propose chaque .zip dans l'onglet Drivers. La section multiLogin peut aussi être configurée depuis l'onglet Connexions.",
  "driversDir": "/mnt/software/DRIVERS",
  "multiLogin": {
    "enabled": false,
    "mode": "block",
    "promptTimeoutSeconds": 45,
    "excludedUsers": ["administrator", "administrateur", "admin", "maintenance", "system", "local service", "network service", "defaultuser0", "dwm-*", "umfd-*"]
  }
}
