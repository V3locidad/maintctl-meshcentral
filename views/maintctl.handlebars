refreshAgents().then(function () {
  // Restaure une tâche en cours si on a fermé la page entre-temps
  restoreCleanRun();
  restoreDrvRun();
});

// ============================================================
// Registre (ex-regctl, intégré). Toutes les fns préfixées reg*.
// ============================================================
(function () {
  function $$(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c];
    });
  }
  function setBusy(on) { $$('regSpinner').classList.toggle('on', !!on); }

  function apiReg(action, qs, body) {
    var url = 'pluginadmin.ashx?pin=maintctl&action=' + encodeURIComponent(action);
    if (qs) Object.keys(qs).forEach(function (k) {
      url += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(qs[k]);
    });
    if (body) url += '&payload=' + encodeURIComponent(JSON.stringify(body));
    return fetch(url, { credentials: 'include' }).then(function (r) { return r.json(); });
  }

  // Dispatch + long-polling. Renvoie une promesse résolue avec result.data.
  function callAgentReg(action, body) {
    setBusy(true);
    return apiReg(action, null, body).then(function (r) {
      if (!r || !r.ok) { setBusy(false); throw new Error((r && r.error) || 'dispatch KO'); }
      var dispatchId = r.dispatchId;
      var tries = 0;
      return new Promise(function (resolve, reject) {
        function poll() {
          tries++;
          apiReg('regPollResult', { dispatchId: dispatchId }).then(function (p) {
            if (p.ready) {
              setBusy(false);
              if (p.result && p.result.ok) resolve(p.result.data);
              else reject(new Error((p.result && p.result.error) || 'erreur agent'));
            } else if (p.unknown || tries > 4) {
              setBusy(false);
              reject(new Error(p.unknown ? 'dispatch perdu' : 'timeout'));
            } else poll();
          }).catch(function (e) { setBusy(false); reject(e); });
        }
        poll();
      });
    });
  }

  // --- Agents ---
  var regAgents = [];
  var regActiveNode = null;
  var regChecked = {};

  function regLoadAgents() {
    return apiReg('agents').then(function (r) {
      // n'inclut que les Windows (l'agent registre tourne PS Windows)
      regAgents = (r.agents || []).filter(function (a) { return (a.family || '').toLowerCase() === 'windows' || /win/i.test(a.os || ''); });
      regRenderAgents();
      regUpdateBatchTag();
    });
  }

  function regRenderAgents() {
    var q = ($$('regAgentFilter').value || '').toLowerCase().trim();
    var filtered = regAgents.filter(function (a) {
      return !q || (a.name || '').toLowerCase().indexOf(q) !== -1 || (a.mesh || '').toLowerCase().indexOf(q) !== -1;
    });
    if (!filtered.length) {
      $$('regAgentsList').innerHTML = '<div class="regEmpty">Aucun poste.</div>';
      $$('regAgentsStats').textContent = '0 / ' + regAgents.length;
      return;
    }
    $$('regAgentsList').innerHTML = filtered.map(function (a) {
      var actCls = (a.id === regActiveNode ? ' active' : '');
      var checked = regChecked[a.id] ? ' checked' : '';
      var dot = a.online ? 'on' : 'off';
      return '<div class="regAg' + actCls + '" data-id="' + esc(a.id) + '">'
           +   '<input type="checkbox" class="chk"' + checked + (a.online ? '' : ' disabled') + '>'
           +   '<span class="dot ' + dot + '" title="' + (a.online ? 'En ligne' : 'Hors ligne') + '"></span>'
           +   '<span class="name">' + esc(a.name) + '</span>'
           +   '<span class="mesh">' + esc(a.mesh) + '</span>'
           + '</div>';
    }).join('');
    var on = filtered.filter(function (a) { return a.online; }).length;
    $$('regAgentsStats').textContent = filtered.length + ' / ' + regAgents.length + ' postes · ' + on + ' en ligne';
    Array.prototype.slice.call(document.querySelectorAll('#regAgentsList .regAg')).forEach(function (row) {
      var id = row.getAttribute('data-id');
      var chk = row.querySelector('.chk');
      chk.onchange = function () {
        if (chk.checked) regChecked[id] = true; else delete regChecked[id];
        regUpdateBatchTag();
      };
      chk.onclick = function (ev) { ev.stopPropagation(); };
      row.onclick = function () {
        var a = regAgents.find(function (x) { return x.id === id; });
        if (!a || !a.online) return;
        regActiveNode = id;
        regRenderAgents();
        regResetBrowser();
        regRenderRoots();
      };
    });
  }

  function regUpdateBatchTag() {
    var n = Object.keys(regChecked).length;
    var tag = $$('regBatchTag');
    if (n <= 1) { tag.style.display = 'none'; return; }
    tag.style.display = '';
    tag.textContent = 'Batch : ' + n + ' postes cochés';
  }

  // --- Tree ---
  var REG_ROOTS = ['HKLM', 'HKCU', 'HKCR', 'HKU', 'HKCC'];
  var regSelPath = null;
  var regSelNode = null;

  function regResetBrowser() {
    regSelPath = null; regSelNode = null;
    $$('regCurPath').textContent = '—';
    $$('regValuesBody').innerHTML = '<div class="regEmpty">Sélectionne une clé pour voir ses valeurs.</div>';
    $$('regNewValBtn').disabled = $$('regNewKeyBtn').disabled = $$('regDelKeyBtn').disabled = true;
  }

  function regNodeHtml(p, label, hasChildren) {
    return '<div class="regNode" data-path="' + esc(p) + '">'
         +   '<span class="label">'
         +     '<span class="twist">' + (hasChildren ? '▸' : ' ') + '</span>'
         +     esc(label)
         +   '</span>'
         +   '<div class="regChildren"></div>'
         + '</div>';
  }

  function regRenderRoots() {
    $$('regTree').innerHTML = REG_ROOTS.map(function (r) { return regNodeHtml(r, r, true); }).join('');
    regBindTree();
  }

  function regBindTree() {
    Array.prototype.slice.call(document.querySelectorAll('#regTree .regNode > .label')).forEach(function (lab) {
      if (lab._regBound) return; lab._regBound = true;
      lab.onclick = function (ev) {
        ev.stopPropagation();
        var node = lab.parentNode;
        var p = node.getAttribute('data-path');
        regSelectKey(p, node);
        regToggleNode(node);
      };
    });
  }

  function regToggleNode(node) {
    var p = node.getAttribute('data-path');
    var children = node.querySelector('.regChildren');
    var twist = node.querySelector('.twist');
    if (children.dataset.loaded === 'open') {
      children.dataset.loaded = 'closed'; children.style.display = 'none'; twist.textContent = '▸'; return;
    }
    if (children.dataset.loaded === 'closed') {
      children.style.display = ''; children.dataset.loaded = 'open'; twist.textContent = '▾'; return;
    }
    twist.textContent = '⋯';
    callAgentReg('regEnumKeys', { nodeId: regActiveNode, path: p }).then(function (data) {
      var keys = (data && data.keys) || [];
      children.innerHTML = keys.map(function (k) { return regNodeHtml(p + '\\' + k, k, true); }).join('') ||
                            '<div style="color:#aaa;padding-left:14px;font-style:italic;font-size:11px">(vide)</div>';
      children.dataset.loaded = 'open'; children.style.display = ''; twist.textContent = keys.length ? '▾' : '·';
      regBindTree();
    }).catch(function (e) {
      children.innerHTML = '<div class="regErr">' + esc(e.message) + '</div>';
      children.dataset.loaded = 'open'; children.style.display = ''; twist.textContent = '!';
    });
  }

  function regSelectKey(p, nodeEl) {
    regSelPath = p;
    if (regSelNode) regSelNode.classList.remove('selected');
    regSelNode = nodeEl;
    if (nodeEl) nodeEl.classList.add('selected');
    $$('regCurPath').textContent = p;
    $$('regNewValBtn').disabled = false;
    $$('regNewKeyBtn').disabled = false;
    $$('regDelKeyBtn').disabled = (REG_ROOTS.indexOf(p) !== -1);
    regLoadValues(p);
  }

  function regLoadValues(p) {
    $$('regValuesBody').innerHTML = '<div class="regEmpty">Chargement…</div>';
    callAgentReg('regEnumValues', { nodeId: regActiveNode, path: p }).then(function (data) {
      var vals = (data && data.values) || [];
      if (!vals.length) { $$('regValuesBody').innerHTML = '<div class="regEmpty">Aucune valeur.</div>'; return; }
      var rows = vals.map(function (v) {
        var dataStr = (v.type === 'MultiString' && Array.isArray(v.data)) ? v.data.join(' | ') : String(v.data == null ? '' : v.data);
        return '<tr data-name="' + esc(v.name) + '">'
             +   '<td>' + (v.name || '<i>(Par défaut)</i>') + '</td>'
             +   '<td><span class="regBadge">' + esc(v.type) + '</span></td>'
             +   '<td class="data">' + esc(dataStr.slice(0, 200)) + (dataStr.length > 200 ? '…' : '') + '</td>'
             +   '<td style="white-space:nowrap">'
             +     '<button data-act="edit" data-name="' + esc(v.name) + '">Éditer</button> '
             +     '<button class="regDanger" data-act="del" data-name="' + esc(v.name) + '">×</button>'
             +   '</td></tr>';
      }).join('');
      $$('regValuesBody').innerHTML = '<table class="regTable"><thead><tr><th>Nom</th><th>Type</th><th>Valeur</th><th></th></tr></thead><tbody>' + rows + '</tbody></table>';
      Array.prototype.slice.call($$('regValuesBody').querySelectorAll('button[data-act]')).forEach(function (b) {
        b.onclick = function (ev) {
          ev.stopPropagation();
          var act = b.getAttribute('data-act');
          var nm = b.getAttribute('data-name');
          if (act === 'edit') regEditValue(nm, vals.find(function (x) { return x.name === nm; }));
          else if (act === 'del') regDeleteValue(nm);
        };
      });
    }).catch(function (e) {
      $$('regValuesBody').innerHTML = '<div class="regErr">' + esc(e.message) + '</div>';
    });
  }

  function regTargetNodes() {
    var ids = Object.keys(regChecked);
    if (!ids.length && regActiveNode) ids = [regActiveNode];
    return ids;
  }

  // --- Modale ---
  function regShowModal(html) {
    var bg = document.createElement('div'); bg.className = 'regModalBg';
    bg.innerHTML = '<div class="regModal">' + html + '</div>';
    document.body.appendChild(bg);
    bg.onclick = function (e) { if (e.target === bg) document.body.removeChild(bg); };
    return bg;
  }
  function regCloseModal(bg) { try { document.body.removeChild(bg); } catch (e) {} }

  function regBatchDispatch(action, makeBody, label) {
    var ids = regTargetNodes();
    if (!ids.length) return alert('Aucun poste cible.');
    if (ids.length > 1 && !confirm(label + '\nAppliquer sur ' + ids.length + ' postes ?')) return;
    var bg = regShowModal([
      '<h3>' + esc(label) + ' — ' + ids.length + ' poste' + (ids.length > 1 ? 's' : '') + '</h3>',
      '<div id="regBRes" class="regBatchRes"></div>',
      '<div class="actions"><button id="regBClose" disabled>Fermer</button></div>',
    ].join(''));
    var resBox = bg.querySelector('#regBRes');
    var btnClose = bg.querySelector('#regBClose');
    btnClose.onclick = function () { regCloseModal(bg); };
    var nameById = {};
    regAgents.forEach(function (a) { nameById[a.id] = a.name; });
    var i = 0, ok = 0, ko = 0;
    function next() {
      if (i >= ids.length) {
        resBox.innerHTML += '\n<div><b>Terminé : ' + ok + ' OK, ' + ko + ' KO</b></div>';
        btnClose.disabled = false;
        if (regSelPath) regLoadValues(regSelPath);
        return;
      }
      var id = ids[i++];
      var body = makeBody(id);
      resBox.innerHTML += '<div>• ' + esc(nameById[id] || id) + ' … </div>';
      resBox.scrollTop = resBox.scrollHeight;
      callAgentReg(action, body).then(function () {
        ok++; resBox.lastChild.innerHTML += '<span class="ok">OK</span>'; next();
      }).catch(function (e) {
        ko++; resBox.lastChild.innerHTML += '<span class="ko">KO — ' + esc(e.message) + '</span>'; next();
      });
    }
    next();
  }

  var REG_TYPES = ['String', 'ExpandString', 'DWord', 'QWord', 'Binary', 'MultiString'];

  function regEditValue(name, existing) {
    var isNew = !existing;
    var v = existing || { name: name || '', type: 'String', data: '' };
    var typeOpts = REG_TYPES.map(function (t) {
      return '<option value="' + t + '"' + (t === v.type ? ' selected' : '') + '>' + t + '</option>';
    }).join('');
    var dataStr = Array.isArray(v.data) ? v.data.join('\n') : String(v.data == null ? '' : v.data);
    var nIds = regTargetNodes().length;
    var bg = regShowModal([
      '<h3>' + (isNew ? 'Nouvelle valeur' : 'Éditer ' + esc(v.name)) + (nIds > 1 ? ' (' + nIds + ' postes)' : '') + '</h3>',
      '<label>Nom</label><input id="regEvName" value="' + esc(v.name) + '"' + (isNew ? '' : ' disabled') + '>',
      '<label>Type</label><select id="regEvType">' + typeOpts + '</select>',
      '<label id="regEvDataLbl">Donnée</label>',
      '<textarea id="regEvData">' + esc(dataStr) + '</textarea>',
      '<div class="actions"><button id="regEvCancel">Annuler</button><button id="regEvSave">Enregistrer</button></div>',
    ].join(''));
    function updateHint() {
      var t = bg.querySelector('#regEvType').value;
      var lab = bg.querySelector('#regEvDataLbl');
      if (t === 'DWord' || t === 'QWord') lab.textContent = 'Donnée (entier)';
      else if (t === 'Binary') lab.textContent = 'Donnée (hexa, ex: DE AD BE EF)';
      else if (t === 'MultiString') lab.textContent = 'Donnée (une ligne = une entrée)';
      else lab.textContent = 'Donnée';
    }
    bg.querySelector('#regEvType').onchange = updateHint; updateHint();
    bg.querySelector('#regEvCancel').onclick = function () { regCloseModal(bg); };
    bg.querySelector('#regEvSave').onclick = function () {
      var nm = bg.querySelector('#regEvName').value;
      var tp = bg.querySelector('#regEvType').value;
      var dt = bg.querySelector('#regEvData').value;
      regCloseModal(bg);
      regBatchDispatch('regWriteValue', function (nid) {
        return { nodeId: nid, path: regSelPath, name: nm, type: tp, data: dt };
      }, 'Écrire ' + nm);
    };
  }

  function regDeleteValue(name) {
    regBatchDispatch('regDeleteValue', function (nid) {
      return { nodeId: nid, path: regSelPath, name: name };
    }, 'Supprimer la valeur ' + name);
  }

  function regCreateKey() {
    var sub = prompt('Nom de la sous-clé à créer sous\n' + regSelPath);
    if (!sub) return;
    regBatchDispatch('regCreateKey', function (nid) {
      return { nodeId: nid, path: regSelPath + '\\' + sub };
    }, 'Créer la clé ' + sub);
    setTimeout(function () {
      if (regSelNode && regActiveNode) {
        var children = regSelNode.querySelector('.regChildren');
        children.dataset.loaded = ''; children.innerHTML = '';
        regToggleNode(regSelNode);
      }
    }, 800);
  }

  function regDeleteCurrentKey() {
    if (!confirm('Supprimer DÉFINITIVEMENT la clé\n\n' + regSelPath + '\n\net tout son contenu ?')) return;
    regBatchDispatch('regDeleteKey', function (nid) {
      return { nodeId: nid, path: regSelPath };
    }, 'Supprimer la clé ' + regSelPath);
  }

  // --- Quick action ---
  var REG_QUICK_OPS = [
    { id: 'regCreateKey',   tone: 'green',  title: 'Créer une clé',           sub: 'Ajoute une clé de registre.' },
    { id: 'regWriteValue',  tone: 'blue',   title: 'Écrire une valeur',        sub: 'Crée ou modifie une valeur dans une clé.' },
    { id: 'regDeleteValue', tone: 'orange', title: 'Supprimer une valeur',     sub: 'Retire UNE valeur d\'une clé.' },
    { id: 'regDeleteKey',   tone: 'red',    title: 'Supprimer une clé',        sub: 'Détruit la clé ET tout son contenu.' },
  ];

  function regOpenQuick() {
    var nIds = regTargetNodes().length;
    if (!nIds) return alert('Coche au moins un poste (ou clique sur un poste actif).');
    var typeOpts = REG_TYPES.map(function (t) { return '<option>' + t + '</option>'; }).join('');
    var cards = REG_QUICK_OPS.map(function (o) {
      return '<div class="regQaCard regTone-' + o.tone + '" data-op="' + o.id + '">'
           +   '<div><div style="font-weight:600;font-size:13px">' + o.title + '</div>'
           +   '<div style="font-size:11px;color:#777;margin-top:2px">' + o.sub + '</div></div>'
           + '</div>';
    }).join('');
    var bg = regShowModal([
      '<h3>Action rapide <span style="font-weight:400;color:#666">— ' + nIds + ' poste' + (nIds > 1 ? 's' : '') + '</span></h3>',
      '<div class="regQaGrid">' + cards + '</div>',
      '<div id="regQaForm" style="display:none">',
      '  <div id="regQaSel" class="regQaSel"></div>',
      '  <label>Chemin de clé</label><input id="regQaPath" placeholder="ex: HKLM\\Software\\MonAppli">',
      '  <div id="regQaValBlock"><label>Nom de la valeur</label><input id="regQaName" placeholder="(vide = valeur par défaut)">',
      '    <div id="regQaTypeBlock"><label>Type</label><select id="regQaType">' + typeOpts + '</select>',
      '    <label id="regQaDataLbl">Donnée</label><textarea id="regQaData"></textarea></div>',
      '  </div>',
      '  <div class="actions"><button id="regQaBack">← Changer d\'action</button><button id="regQaCancel">Annuler</button><button id="regQaRun">Exécuter</button></div>',
      '</div>',
      '<div id="regQaCancelOnly" class="actions"><button id="regQaCancel2">Annuler</button></div>',
    ].join(''));
    var selectedOp = null;
    var form = bg.querySelector('#regQaForm');
    var grid = bg.querySelector('.regQaGrid');
    var cancelOnly = bg.querySelector('#regQaCancelOnly');
    var selBox = bg.querySelector('#regQaSel');
    var qaType = bg.querySelector('#regQaType');
    var qaLbl = bg.querySelector('#regQaDataLbl');
    var valBlock = bg.querySelector('#regQaValBlock');
    var typeBlock = bg.querySelector('#regQaTypeBlock');
    var runBtn = bg.querySelector('#regQaRun');
    function updateHint() {
      var t = qaType.value;
      if (t === 'DWord' || t === 'QWord') qaLbl.textContent = 'Donnée (entier)';
      else if (t === 'Binary') qaLbl.textContent = 'Donnée (hexa, ex: DE AD BE EF)';
      else if (t === 'MultiString') qaLbl.textContent = 'Donnée (une ligne = une entrée)';
      else qaLbl.textContent = 'Donnée';
    }
    qaType.onchange = updateHint;
    function pickOp(op) {
      selectedOp = op;
      grid.style.display = 'none'; cancelOnly.style.display = 'none'; form.style.display = '';
      selBox.className = 'regQaSel regTone-' + op.tone;
      selBox.innerHTML = '<b>' + op.title + '</b>';
      valBlock.style.display = (op.id === 'regCreateKey' || op.id === 'regDeleteKey') ? 'none' : '';
      typeBlock.style.display = (op.id === 'regWriteValue') ? '' : 'none';
      runBtn.textContent = op.title;
      updateHint();
    }
    Array.prototype.slice.call(bg.querySelectorAll('.regQaCard')).forEach(function (c) {
      c.onclick = function () { pickOp(REG_QUICK_OPS.find(function (x) { return x.id === c.getAttribute('data-op'); })); };
    });
    bg.querySelector('#regQaBack').onclick = function () { selectedOp = null; form.style.display = 'none'; grid.style.display = ''; cancelOnly.style.display = ''; };
    bg.querySelector('#regQaCancel').onclick = function () { regCloseModal(bg); };
    bg.querySelector('#regQaCancel2').onclick = function () { regCloseModal(bg); };
    runBtn.onclick = function () {
      if (!selectedOp) return;
      var act = selectedOp.id;
      var p = bg.querySelector('#regQaPath').value.trim();
      if (!p) return alert('Chemin requis.');
      var nm = bg.querySelector('#regQaName').value;
      var tp = qaType.value;
      var dt = bg.querySelector('#regQaData').value;
      if (act === 'regDeleteKey' && !confirm('Supprimer DÉFINITIVEMENT la clé\n\n' + p + '\n\net tout son contenu sur ' + nIds + ' poste(s) ?')) return;
      var label = ({
        regCreateKey: 'Créer ' + p,
        regDeleteKey: 'Supprimer ' + p,
        regWriteValue: 'Écrire ' + (nm || '(défaut)') + ' dans ' + p,
        regDeleteValue: 'Supprimer ' + (nm || '(défaut)') + ' de ' + p,
      })[act];
      regCloseModal(bg);
      regBatchDispatch(act, function (nid) {
        var body = { nodeId: nid, path: p };
        if (act === 'regWriteValue') { body.name = nm; body.type = tp; body.data = dt; }
        else if (act === 'regDeleteValue') { body.name = nm; }
        return body;
      }, label);
    };
  }

  // --- Templates ---
  function regOpenTemplates() {
    var bg = regShowModal([
      '<h3>Modèles de regkeys <button id="regTplNew" style="float:right;font-size:12px">+ Nouveau modèle</button></h3>',
      '<div id="regTplBody" style="max-height:60vh;overflow:auto"><div class="regEmpty">Chargement…</div></div>',
      '<div class="actions"><button id="regTplClose">Fermer</button></div>',
    ].join(''));
    bg.querySelector('#regTplClose').onclick = function () { regCloseModal(bg); };
    bg.querySelector('#regTplNew').onclick = function () {
      regCloseModal(bg);
      regOpenTemplateEditor(null);
    };
    function reload() {
      apiReg('regTemplates').then(function (r) {
        if (r.error) { bg.querySelector('#regTplBody').innerHTML = '<div class="regEmpty">' + esc(r.error) + '</div>'; return; }
        var cats = (r.categories || []);
        var hidden = r.hiddenBuiltins || [];
        var html = '';
        if (hidden.length) {
          html += '<div style="background:#f8f9fa;border:1px dashed #ccc;border-radius:4px;padding:6px 10px;margin-bottom:10px;font-size:11px;color:#666">'
                + hidden.length + ' modèle(s) livré(s) masqué(s) : '
                + hidden.map(function (h) {
                    return '<button class="regTplUnhide" data-id="' + esc(h.id) + '" style="font-size:11px;padding:1px 6px;margin:1px">' + esc(h.name) + ' ↺</button>';
                  }).join(' ')
                + '</div>';
        }
        if (!cats.length && !hidden.length) { bg.querySelector('#regTplBody').innerHTML = '<div class="regEmpty">Aucun modèle. Clique sur "+ Nouveau modèle".</div>'; return; }
        cats.forEach(function (c) {
          html += '<div style="margin:10px 0 4px 0;font-weight:600;color:#333">' + esc(c.name) + '</div>';
          (c.templates || []).forEach(function (t) {
            var actions = '<button class="regTplApply" data-id="' + esc(t.id) + '">Appliquer</button>'
                        + ' <button class="regTplEdit" data-id="' + esc(t.id) + '" title="Éditer">✎</button>'
                        + ' <button class="regTplDel regDanger" data-id="' + esc(t.id) + '" title="Supprimer">×</button>';
            if (t._origin === 'override') {
              actions += ' <button class="regTplRevert" data-id="' + esc(t.id) + '" title="Restaurer la version livrée">↺</button>';
            }
            var originBadge = '';
            if (t._origin === 'builtin') originBadge = '<span style="font-size:10px;color:#888;background:#eee;padding:1px 5px;border-radius:3px;margin-left:6px" title="Modèle livré avec le plugin">livré</span>';
            else if (t._origin === 'override') originBadge = '<span style="font-size:10px;color:#856404;background:#fff3cd;padding:1px 5px;border-radius:3px;margin-left:6px" title="Modèle livré que tu as modifié">modifié</span>';
            else originBadge = '<span style="font-size:10px;color:#1c6b3e;background:#e7f7ee;padding:1px 5px;border-radius:3px;margin-left:6px" title="Modèle personnalisé">perso</span>';
            html += '<div style="border:1px solid #e0e0e0;border-radius:4px;padding:8px;margin-bottom:6px;display:flex;gap:8px;align-items:flex-start">'
                  + '<div style="flex:1">'
                  + '  <div style="font-weight:500">' + esc(t.name) + originBadge + '</div>'
                  + '  <div style="font-size:12px;color:#666;margin-top:2px">' + esc(t.description || '') + '</div>'
                  + '  <div style="font-size:11px;color:#999;margin-top:2px">' + (t.ops || []).length + ' opération(s)</div>'
                  + '</div>'
                  + '<div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">' + actions + '</div>'
                  + '</div>';
          });
        });
        var body = bg.querySelector('#regTplBody');
        body.innerHTML = html;
        var index = {};
        cats.forEach(function (c) { (c.templates || []).forEach(function (t) { t._category = c.name; index[t.id] = t; }); });
        Array.prototype.forEach.call(body.querySelectorAll('.regTplApply'), function (btn) {
          btn.onclick = function () {
            var tpl = index[btn.getAttribute('data-id')];
            if (!tpl) return;
            regCloseModal(bg);
            regApplyTemplate(tpl);
          };
        });
        Array.prototype.forEach.call(body.querySelectorAll('.regTplEdit'), function (btn) {
          btn.onclick = function () {
            var tpl = index[btn.getAttribute('data-id')];
            if (!tpl) return;
            regCloseModal(bg);
            regOpenTemplateEditor(tpl);
          };
        });
        Array.prototype.forEach.call(body.querySelectorAll('.regTplDel'), function (btn) {
          btn.onclick = function () {
            var id = btn.getAttribute('data-id');
            var tpl = index[id];
            var msg = 'Supprimer le modèle "' + (tpl && tpl.name || id) + '" ?';
            if (tpl && (tpl._origin === 'builtin' || tpl._origin === 'override')) {
              msg += '\n\n(Modèle livré : il sera masqué. Tu pourras le restaurer plus tard via ↺.)';
            }
            if (!confirm(msg)) return;
            apiReg('regTemplateDelete', { id: id }).then(function (r) {
              if (r.error) return alert('Erreur : ' + r.error);
              reload();
            });
          };
        });
        Array.prototype.forEach.call(body.querySelectorAll('.regTplRevert'), function (btn) {
          btn.onclick = function () {
            var id = btn.getAttribute('data-id');
            if (!confirm('Restaurer la version livrée de ce modèle ? Tes modifications seront perdues.')) return;
            apiReg('regTemplateRevert', { id: id }).then(function (r) {
              if (r.error) return alert('Erreur : ' + r.error);
              reload();
            });
          };
        });
        Array.prototype.forEach.call(body.querySelectorAll('.regTplUnhide'), function (btn) {
          btn.onclick = function () {
            apiReg('regTemplateRevert', { id: btn.getAttribute('data-id') }).then(function (r) {
              if (r.error) return alert('Erreur : ' + r.error);
              reload();
            });
          };
        });
      });
    }
    reload();
  }

  // --- Éditeur de modèle (création / édition d'un custom) ---
  function regOpenTemplateEditor(existing) {
    var isEdit = !!existing;
    var ops = isEdit ? (existing.ops || []).map(function (o) { return Object.assign({}, o); }) : [];
    var bg = regShowModal([
      '<h3>' + (isEdit ? 'Éditer le modèle' : 'Nouveau modèle') + '</h3>',
      '<label>Nom</label><input id="regTplName" value="' + esc(isEdit ? existing.name : '') + '" placeholder="ex: Masquer OneDrive">',
      '<label>Catégorie</label><input id="regTplCat" value="' + esc(isEdit ? (existing._category || 'Personnalisés') : 'Personnalisés') + '" placeholder="Personnalisés">',
      '<label>Description</label><input id="regTplDesc" value="' + esc(isEdit ? (existing.description || '') : '') + '" placeholder="Courte description (optionnel)">',
      '<label style="margin-top:10px">Opérations <span style="color:#888;font-weight:normal;font-size:11px">(exécutées dans l\'ordre)</span></label>',
      '<div id="regTplOps" style="border:1px solid #eee;border-radius:4px;padding:6px;background:#fafafa;max-height:300px;overflow:auto"></div>',
      '<div style="margin-top:6px"><button id="regTplAddOp">+ Ajouter une opération</button></div>',
      '<div class="actions">',
      '  <button id="regTplCancel">Annuler</button>',
      '  <button id="regTplSave">Enregistrer</button>',
      '</div>',
    ].join(''));

    var REG_TYPES_FULL = ['String', 'ExpandString', 'DWord', 'QWord', 'Binary', 'MultiString', 'REG_SZ', 'REG_DWORD', 'REG_QWORD', 'REG_EXPAND_SZ', 'REG_BINARY', 'REG_MULTI_SZ'];

    function renderOps() {
      var box = bg.querySelector('#regTplOps');
      if (!ops.length) { box.innerHTML = '<div class="regEmpty" style="padding:6px">Aucune opération. Clique sur "+ Ajouter une opération".</div>'; return; }
      box.innerHTML = ops.map(function (op, idx) {
        var actSel = ['writeValue','deleteValue','createKey','deleteKey'].map(function (a) {
          return '<option value="' + a + '"' + (a === op.op ? ' selected' : '') + '>' + a + '</option>';
        }).join('');
        var typeSel = REG_TYPES_FULL.map(function (t) {
          return '<option' + (t === op.type ? ' selected' : '') + '>' + t + '</option>';
        }).join('');
        var showName = (op.op === 'writeValue' || op.op === 'deleteValue');
        var showType = (op.op === 'writeValue');
        var dataVal = Array.isArray(op.data) ? op.data.join('\n') : (op.data == null ? '' : String(op.data));
        return '<div style="border:1px solid #ddd;border-radius:4px;padding:6px;margin-bottom:6px;background:#fff" data-idx="' + idx + '">'
             + '<div style="display:flex;gap:6px;align-items:center;margin-bottom:4px">'
             + '  <b style="font-size:11px;color:#666">#' + (idx + 1) + '</b>'
             + '  <select class="opAct" style="flex:0 0 130px">' + actSel + '</select>'
             + '  <input class="opPath" placeholder="HKLM\\Software\\..." value="' + esc(op.path || '') + '" style="flex:1">'
             + '  <button class="opUp" title="Monter">▲</button>'
             + '  <button class="opDn" title="Descendre">▼</button>'
             + '  <button class="opDel regDanger" title="Supprimer">×</button>'
             + '</div>'
             + '<div class="opNameWrap" style="display:' + (showName ? 'flex' : 'none') + ';gap:6px;margin-bottom:4px">'
             + '  <input class="opName" placeholder="nom valeur (vide = défaut)" value="' + esc(op.name == null ? '' : op.name) + '" style="flex:1">'
             + '  <select class="opType" style="flex:0 0 130px;display:' + (showType ? '' : 'none') + '">' + typeSel + '</select>'
             + '</div>'
             + '<div class="opDataWrap" style="display:' + (showType ? 'block' : 'none') + '">'
             + '  <textarea class="opData" placeholder="donnée (entier pour DWord, hex pour Binary, 1 ligne par entrée pour MultiString)" style="width:100%;box-sizing:border-box;font-family:Menlo,Consolas,monospace;font-size:11px;min-height:40px">' + esc(dataVal) + '</textarea>'
             + '</div>'
             + '</div>';
      }).join('');
      // Bind handlers — read back values on every change
      Array.prototype.forEach.call(box.querySelectorAll('[data-idx]'), function (row) {
        var idx = parseInt(row.getAttribute('data-idx'), 10);
        var sel = row.querySelector('.opAct');
        sel.onchange = function () {
          ops[idx].op = sel.value;
          renderOps();
        };
        row.querySelector('.opPath').oninput = function (e) { ops[idx].path = e.target.value; };
        var nameInput = row.querySelector('.opName');
        if (nameInput) nameInput.oninput = function (e) { ops[idx].name = e.target.value; };
        var typeSel2 = row.querySelector('.opType');
        if (typeSel2) typeSel2.onchange = function () { ops[idx].type = typeSel2.value; };
        var dataT = row.querySelector('.opData');
        if (dataT) dataT.oninput = function (e) { ops[idx].data = e.target.value; };
        row.querySelector('.opUp').onclick = function () {
          if (idx === 0) return;
          var tmp = ops[idx - 1]; ops[idx - 1] = ops[idx]; ops[idx] = tmp; renderOps();
        };
        row.querySelector('.opDn').onclick = function () {
          if (idx === ops.length - 1) return;
          var tmp = ops[idx + 1]; ops[idx + 1] = ops[idx]; ops[idx] = tmp; renderOps();
        };
        row.querySelector('.opDel').onclick = function () {
          if (!confirm('Supprimer l\'opération #' + (idx + 1) + ' ?')) return;
          ops.splice(idx, 1); renderOps();
        };
      });
    }
    renderOps();

    bg.querySelector('#regTplAddOp').onclick = function () {
      ops.push({ op: 'writeValue', path: '', name: '', type: 'DWord', data: '1' });
      renderOps();
    };
    bg.querySelector('#regTplCancel').onclick = function () { regCloseModal(bg); regOpenTemplates(); };
    bg.querySelector('#regTplSave').onclick = function () {
      var body = {
        id: isEdit ? existing.id : '',
        name: bg.querySelector('#regTplName').value.trim(),
        category: bg.querySelector('#regTplCat').value.trim() || 'Personnalisés',
        description: bg.querySelector('#regTplDesc').value.trim(),
        ops: ops.map(function (o) {
          var clean = { op: o.op, path: o.path };
          if (o.op === 'writeValue' || o.op === 'deleteValue') clean.name = o.name == null ? '' : o.name;
          if (o.op === 'writeValue') { clean.type = o.type || 'String'; clean.data = o.data == null ? '' : o.data; }
          return clean;
        }),
      };
      if (!body.name) return alert('Nom requis.');
      if (!body.ops.length) return alert('Ajoute au moins une opération.');
      for (var i = 0; i < body.ops.length; i++) {
        if (!body.ops[i].path) return alert('Op #' + (i + 1) + ' : chemin requis.');
      }
      apiReg('regTemplateSave', null, body).then(function (r) {
        if (r.error) return alert('Erreur : ' + r.error);
        regCloseModal(bg);
        regOpenTemplates();
      });
    };
  }

  function regApplyTemplate(tpl) {
    var ids = regTargetNodes();
    if (!ids.length) return alert('Aucun poste cible.');
    if (!confirm('Appliquer "' + tpl.name + '" sur ' + ids.length + ' poste(s) ?\n\n' + (tpl.ops || []).length + ' opération(s) par poste.')) return;
    var bg = regShowModal([
      '<h3>Application : ' + esc(tpl.name) + ' — ' + ids.length + ' poste' + (ids.length > 1 ? 's' : '') + '</h3>',
      '<div id="regBRes" class="regBatchRes"></div>',
      '<div class="actions"><button id="regBClose" disabled>Fermer</button></div>',
    ].join(''));
    var resBox = bg.querySelector('#regBRes');
    var btnClose = bg.querySelector('#regBClose');
    btnClose.onclick = function () { regCloseModal(bg); };
    var nameById = {};
    regAgents.forEach(function (a) { nameById[a.id] = a.name; });
    var opMap = { writeValue: 'regWriteValue', deleteValue: 'regDeleteValue', createKey: 'regCreateKey', deleteKey: 'regDeleteKey' };
    var i = 0, okN = 0, koN = 0;
    function next() {
      if (i >= ids.length) {
        resBox.innerHTML += '\n<div><b>Terminé : ' + okN + ' OK, ' + koN + ' KO</b></div>';
        btnClose.disabled = false;
        return;
      }
      var id = ids[i++];
      resBox.innerHTML += '<div>• ' + esc(nameById[id] || id) + ' … </div>';
      resBox.scrollTop = resBox.scrollHeight;
      var line = resBox.lastChild;
      var ops = (tpl.ops || []).slice();
      var failed = false;
      function nextOp() {
        if (failed || !ops.length) {
          if (failed) { koN++; } else { okN++; line.innerHTML += '<span class="ok">OK</span>'; }
          return next();
        }
        var op = ops.shift();
        var action = opMap[op.op] || ('reg' + op.op.charAt(0).toUpperCase() + op.op.slice(1));
        var body = { nodeId: id, path: op.path };
        if (op.name !== undefined) body.name = op.name;
        if (op.type !== undefined) body.type = op.type;
        if (op.data !== undefined) body.data = op.data;
        callAgentReg(action, body).then(nextOp).catch(function (e) {
          failed = true;
          line.innerHTML += '<span class="ko">KO — ' + esc(op.op + ': ' + e.message) + '</span>';
          next();
        });
      }
      nextOp();
    }
    next();
  }

  // --- Bindings ---
  $$('regAgentFilter').oninput = regRenderAgents;
  $$('regRefreshAgents').onclick = regLoadAgents;
  $$('regAgentSelAll').onclick = function () {
    var any = Object.keys(regChecked).length > 0;
    regChecked = {};
    if (!any) regAgents.filter(function (a) { return a.online; }).forEach(function (a) { regChecked[a.id] = true; });
    regRenderAgents(); regUpdateBatchTag();
  };
  $$('regRefreshTree').onclick = function () { if (regActiveNode) regRenderRoots(); };
  $$('regNewValBtn').onclick = function () { if (regSelPath) regEditValue('', null); };
  $$('regNewKeyBtn').onclick = function () { if (regSelPath) regCreateKey(); };
  $$('regDelKeyBtn').onclick = function () { if (regSelPath) regDeleteCurrentKey(); };
  $$('regQuickBtn').onclick = regOpenQuick;
  $$('regTemplatesBtn').onclick = regOpenTemplates;

  // Charge la liste à la 1re ouverture du tab (lazy).
  var regLoaded = false;
  document.querySelector('.tab[data-tab="registry"]').addEventListener('click', function () {
    if (regLoaded) return;
    regLoaded = true;
    regLoadAgents();
  });
})();

// =================================================================
// ---- CONNEXIONS MULTIPLES ----
(function () {
  var loaded = false;
  var editing = false, editRevision = 0, saving = false;
  var lastData = null, loading = null, loadVersion = 0, updatedAt = 0;

  function multiLoginDate(ms) {
    if (!ms) return '—';
    try { return new Date(ms).toLocaleString('fr-FR'); } catch (_) { return '—'; }
  }

  function multiLoginFullDate(ms) {
    if (!ms) return '—';
    try {
      return new Date(ms).toLocaleString('fr-FR', {
        weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit', second: '2-digit'
      });
    } catch (_) { return '—'; }
  }

  function selectedMultiLoginMode() {
    var item = document.querySelector('input[name="multiLoginMode"]:checked');
    return item ? item.value : 'block';
  }

  function updateMultiLoginInputs() {
    var enabled = document.getElementById('multiLoginEnabled').checked;
    Array.prototype.forEach.call(document.querySelectorAll('input[name="multiLoginMode"]'), function (input) {
      input.disabled = !enabled;
    });
    document.getElementById('multiLoginTimeout').disabled = !enabled || selectedMultiLoginMode() !== 'prompt';
  }

  function updateEditState() {
    document.getElementById('multiLoginEditState').textContent = editing ? 'Modifications non enregistrées' : '';
    document.getElementById('multiLoginResetBtn').hidden = !editing;
    document.getElementById('multiLoginResetBtn').disabled = saving;
    document.getElementById('multiLoginSaveBtn').disabled = saving || !lastData;
  }
  function connectionMatches(item) {
    var q = document.getElementById('multiLoginSearch').value.toLowerCase().trim();
    if (!q) return true;
    var values = [item.username, item.userKey, item.name, item.mesh, item.detail, item.kind];
    (item.sessions || []).forEach(function (session) { values.push(session.name, session.mesh); });
    return values.some(function (value) { return String(value || '').toLowerCase().indexOf(q) !== -1; });
  }

  function renderMultiLogin(data) {
    document.getElementById('multiLoginLastUpdate').textContent = 'Actualisé à ' + new Date(updatedAt).toLocaleTimeString('fr-FR') + ' · 10 s';
    var searching = !!document.getElementById('multiLoginSearch').value.trim();
    var settings = data.settings || {};
    if (!editing) {
      document.getElementById('multiLoginEnabled').checked = !!settings.enabled;
      var mode = document.querySelector('input[name="multiLoginMode"][value="' + (settings.mode === 'prompt' ? 'prompt' : 'block') + '"]');
      if (mode) mode.checked = true;
      document.getElementById('multiLoginTimeout').value = settings.promptTimeoutSeconds || 45;
      document.getElementById('multiLoginExcluded').value = (settings.excludedUsers || []).join(', ');
    }
    updateMultiLoginInputs(); updateEditState();
    document.getElementById('multiLoginState').textContent = settings.enabled
      ? (settings.mode === 'prompt'
          ? 'Mode actif : proposer de fermer la session distante'
          : 'Mode actif : fermer immédiatement la nouvelle session')
      : 'Connexions multiples autorisées · conflits surveillés';
    var watcher = data.watcher || {};
    var watcherState = document.getElementById('multiLoginWatcherState');
    watcherState.style.display = 'inline-block';
    watcherState.textContent = (settings.enabled ? 'Journal Windows : ' : 'Inventaire Windows : ') + (watcher.running || 0) + ' / ' + (watcher.online || 0) + ' agent(s)';
    watcherState.style.background = (watcher.running === watcher.online && watcher.online > 0) ? '#d4edda' : '#fff3cd';
    watcherState.style.color = (watcher.running === watcher.online && watcher.online > 0) ? '#155724' : '#6b5200';
    watcherState.title = (watcher.errors || []).map(function (item) { return item.name + ' : ' + item.error; }).join('\n');

    var conflicts = (data.conflicts || []).filter(connectionMatches);
    var conflictCount = document.getElementById('multiLoginConflictCount');
    conflictCount.style.display = conflicts.length ? 'inline-block' : 'none';
    conflictCount.textContent = conflicts.length + ' conflit(s)';
    stableHtml(document.getElementById('multiLoginConflicts'), conflicts.length
      ? conflicts.map(function (conflict) {
          return '<div class="multiLoginConflict"><b>' + escapeHtml(conflict.username) + '</b><br>'
            + conflict.sessions.map(function (session) {
                return escapeHtml(session.mesh + ' — ' + session.name);
              }).join('<br>') + '</div>';
        }).join('')
      : '<div class="empty">' + (searching ? 'Aucun conflit correspondant à la recherche.' : 'Aucun conflit en cours.') + '</div>');

    var conflictHistory = (data.conflictHistory || []).filter(connectionMatches);
    var conflictHistoryTotal = Number(data.conflictHistoryTotal || conflictHistory.length);
    var conflictRetentionDays = Number(data.conflictRetentionDays || 30);
    document.getElementById('multiLoginConflictHistoryTitle').textContent = 'Historique des conflits — conservation ' + conflictRetentionDays + ' jours (' + conflictHistoryTotal + ')';
    stableHtml(document.getElementById('multiLoginConflictHistory'), conflictHistory.length
      ? '<table class="multiLoginTable"><thead><tr>'
        + '<th>Utilisateur</th><th>Salles et postes concernés</th><th>Première détection</th><th>Dernière observation</th><th>Fin</th>'
        + '</tr></thead><tbody>'
        + conflictHistory.map(function (conflict) {
            var locations = (conflict.sessions || []).map(function (session) {
              return escapeHtml((session.mesh || 'Salle inconnue') + ' — ' + (session.name || session.nodeId || 'Poste inconnu'));
            }).join('<br>');
            return '<tr><td><b>' + escapeHtml(conflict.username || conflict.userKey || '') + '</b>'
              + (conflict.endedAt ? '<div style="font-size:10px;color:#777">Terminé</div>' : '<div style="font-size:10px;color:#b45309">En cours</div>')
              + '</td><td>' + locations + '</td>'
              + '<td>' + escapeHtml(multiLoginFullDate(conflict.firstSeenAt)) + '</td>'
              + '<td>' + escapeHtml(multiLoginFullDate(conflict.lastSeenAt)) + '</td>'
              + '<td>' + (conflict.endedAt ? escapeHtml(multiLoginFullDate(conflict.endedAt)) : '<b>En cours</b>') + '</td></tr>';
          }).join('')
        + '</tbody></table>'
        + (conflictHistoryTotal > (data.conflictHistory || []).length ? '<div class="empty">Affichage limité aux ' + conflictHistory.length + ' conflits affichés parmi les plus récents sur ' + conflictHistoryTotal + ' conservés.</div>' : '')
      : '<div class="empty">' + (searching ? 'Aucun conflit correspondant à la recherche dans cet historique.' : 'Aucun conflit conservé sur les ' + conflictRetentionDays + ' derniers jours.') + '</div>');

    var sessions = (data.sessions || []).filter(connectionMatches);
    stableHtml(document.getElementById('multiLoginSessions'), sessions.length
      ? sessions.map(function (session) {
          return '<tr><td><b>' + escapeHtml(session.username) + '</b></td><td>' + escapeHtml(session.mesh)
            + '</td><td>' + escapeHtml(session.name) + '</td><td>' + multiLoginDate(session.updatedAt) + '</td></tr>';
        }).join('')
      : '<tr><td colspan="4" class="empty">Aucune session correspondant à la recherche sur les agents en ligne.</td></tr>');

    var events = (data.events || []).filter(connectionMatches);
    var eventTotal = Number(data.eventTotal || events.length);
    var eventRetentionDays = Number(data.eventRetentionDays || 30);
    document.getElementById('multiLoginEventsTitle').textContent = 'Journal des décisions — conservation ' + eventRetentionDays + ' jours (' + eventTotal + ')';
    stableHtml(document.getElementById('multiLoginEvents'), events.length
      ? events.map(function (event) {
          return '<div class="multiLoginEvent"><b>' + multiLoginDate(event.time) + '</b> — '
            + escapeHtml(event.username || '') + ' — ' + escapeHtml(event.detail || event.kind || '') + '</div>';
        }).join('') + (eventTotal > (data.events || []).length ? '<div class="empty">Affichage limité aux ' + events.length + ' décisions affichées parmi les plus récentes sur ' + eventTotal + ' conservées.</div>' : '')
      : '<div class="empty">' + (searching ? 'Aucune décision correspondant à la recherche dans ce journal.' : 'Aucune décision conservée sur les ' + eventRetentionDays + ' derniers jours.') + '</div>');
  }

  function loadMultiLogin(force) {
    if (loading && force !== true) return loading;
    var version = ++loadVersion;
    document.getElementById('multiLoginRefreshBtn').disabled = true;
    loading = getJson(BASE + '&action=multiLoginStatus').then(function (data) {
      if (version !== loadVersion) return;
      if (!data || data.error || !data.settings) throw new Error(data && data.error || 'État des connexions invalide');
      lastData = data; updatedAt = Date.now(); loaded = true;
      preserveMaintenanceView(function () { renderMultiLogin(data); });
    }).catch(function (error) {
      if (version === loadVersion) document.getElementById('multiLoginState').textContent = 'Erreur : ' + error.message + (lastData ? ' · dernières données conservées' : '');
    }).then(function () {
      if (version !== loadVersion) return;
      loading = null; document.getElementById('multiLoginRefreshBtn').disabled = false;
    });
    return loading;
  }

  function saveMultiLogin() {
    if (saving || !lastData) return Promise.resolve();
    var revision = editRevision;
    saving = true; loadVersion++; loading = null;
    updateEditState();
    var payload = {
      enabled: document.getElementById('multiLoginEnabled').checked,
      mode: selectedMultiLoginMode(),
      promptTimeoutSeconds: parseInt(document.getElementById('multiLoginTimeout').value, 10) || 45,
      excludedUsers: (document.getElementById('multiLoginExcluded').value || '').split(/[,;\n]+/).map(function (value) {
        return value.trim();
      }).filter(Boolean),
    };
    var button = document.getElementById('multiLoginSaveBtn');
    button.disabled = true;
    return getJson(BASE + '&action=multiLoginSave&payload=' + encodeURIComponent(JSON.stringify(payload))).then(function (result) {
      if (!result.ok) throw new Error(result.error || 'enregistrement impossible');
      if (revision === editRevision) editing = false;
      return loadMultiLogin(true);
    }).catch(function (error) {
      alert('Erreur : ' + error.message);
    }).then(function () { saving = false; updateEditState(); document.getElementById('multiLoginRefreshBtn').disabled = false; });
  }

  var tab = document.querySelector('.tab[data-tab="sessions"]');
  if (tab) tab.addEventListener('click', function () { loadMultiLogin(); });
  document.getElementById('multiLoginRefreshBtn').addEventListener('click', function () { loadMultiLogin(); });
  document.getElementById('multiLoginSaveBtn').addEventListener('click', saveMultiLogin);
  ['multiLoginEnabled', 'multiLoginTimeout', 'multiLoginExcluded'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', function () { editing = true; editRevision++; updateMultiLoginInputs(); updateEditState(); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('input[name="multiLoginMode"]'), function (input) {
    input.addEventListener('change', function () { editing = true; editRevision++; updateMultiLoginInputs(); updateEditState(); });
  });
  document.getElementById('multiLoginResetBtn').addEventListener('click', function () {
    if (!lastData || saving) return;
    editing = false; editRevision++;
    preserveMaintenanceView(function () { renderMultiLogin(lastData); });
  });
  document.getElementById('multiLoginSearch').addEventListener('input', function () {
    if (lastData) preserveMaintenanceView(function () { renderMultiLogin(lastData); });
  });
  updateEditState();
  setInterval(function () {
    if (loaded && !saving && document.getElementById('panel-sessions').classList.contains('active')) loadMultiLogin();
  }, 10000);
})();
</script>

</body>
</html>
