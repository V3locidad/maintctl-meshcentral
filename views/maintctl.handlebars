<script>
var BASE = '/pluginadmin.ashx?pin=maintctl';
var agents = [];
var selected = {};
var currentRunId = null;
var pollTimer = null;
var allDevices = [];
var devCollapsed = {};  // class -> bool (true = collapsed)

// Mapping classes → libellé FR exact comme Windows 10/11 (Gestionnaire de périphériques).
var CLASS_LABELS = {
  AudioEndpoint: 'Entrées et sorties audio',
  Camera: 'Caméras',
  CDROM: 'Lecteurs de DVD/CD-ROM',
  Computer: 'Ordinateur',
  DiskDrive: 'Lecteurs de disque',
  Display: 'Cartes graphiques',
  FDC: 'Contrôleurs de disquettes',
  FloppyDisk: 'Lecteurs de disquettes',
  Firmware: 'Microprogramme',
  HDC: 'Contrôleurs IDE ATA/ATAPI',
  HIDClass: 'Interfaces Homme-machine',
  Image: 'Périphériques d\'images',
  Keyboard: 'Claviers',
  MEDIA: 'Contrôleurs audio, vidéo et jeu',
  Monitor: 'Moniteurs',
  Mouse: 'Souris et autres périphériques de pointage',
  Net: 'Cartes réseau',
  Ports: 'Ports (COM et LPT)',
  Printer: 'Imprimantes',
  PrintQueue: 'Files d\'attente à l\'impression',
  Processor: 'Processeurs',
  SCSIAdapter: 'Contrôleurs de stockage',
  SecurityDevices: 'Périphériques de sécurité',
  SoftwareComponent: 'Composants logiciels',
  SoftwareDevice: 'Périphériques logiciels',
  System: 'Périphériques système',
  USB: 'Contrôleurs de bus USB',
  USBDevice: 'Périphériques USB',
  Volume: 'Volumes de stockage',
  WPD: 'Périphériques portables'
};

// Classes masquées par défaut dans Windows Device Manager (visibles via
// Affichage → Périphériques cachés). On reproduit ce comportement.
var HIDDEN_BY_DEFAULT_CLASSES = {
  Volume: true,
  LegacyDriver: true
};
function classLabel(c) {
  if (!c || c === 'Unknown') return 'Autres périphériques';
  return CLASS_LABELS[c] || c;
}

// Codes problème PnP → explication FR (la liste vient de cfgmgr32.h)
var CM_PROB_FR = {
  1:  "Périphérique non configuré correctement",
  3:  "Pilote du périphérique endommagé ou manque ressources",
  9:  "Le matériel n'est pas reconnu correctement",
  10: "Le périphérique ne peut pas démarrer",
  12: "Conflit de ressources matérielles",
  14: "Redémarrage requis pour terminer la configuration",
  16: "Windows ne peut pas identifier toutes les ressources",
  18: "Réinstallation des pilotes nécessaire",
  19: "Registre endommagé pour ce périphérique",
  21: "Suppression en cours",
  22: "Périphérique désactivé",
  24: "Périphérique pas connecté ou non fonctionnel (CM_PROB 24)",
  28: "Pilote non installé pour ce périphérique",
  29: "Désactivé dans le firmware (BIOS/UEFI)",
  31: "Le pilote ne charge pas correctement",
  32: "Le pilote est désactivé administrativement",
  33: "Windows ne peut pas déterminer les ressources requises",
  35: "Le firmware ne fournit pas assez d'informations",
  37: "Le pilote a renvoyé une erreur",
  38: "Une instance précédente est encore en mémoire",
  39: "Pilote corrompu ou manquant",
  40: "Information du pilote dans le registre invalide",
  41: "Pilote chargé mais le périphérique est introuvable",
  42: "Conflit avec un autre périphérique du même nom",
  43: "Périphérique signalé en erreur par son pilote",
  44: "Application ou service a arrêté le périphérique",
  45: "Périphérique connu mais non connecté actuellement",
  46: "Périphérique en attente du démarrage Windows",
  47: "Préparé pour la suppression sûre",
  48: "Pilote bloqué (incompatible avec cette version de Windows)",
  49: "Hive du registre trop grand pour ajouter le périphérique",
  50: "Échec de l'application des paramètres",
  51: "Périphérique en attente d'un autre périphérique",
  52: "Pilote non signé numériquement",
  53: "Réservé pour le débogueur du noyau",
  54: "Sera redémarré au prochain démarrage"
};
function problemFr(code) {
  if (!code) return '';
  return CM_PROB_FR[code] || ('Code problème ' + code);
}
function classIcon(c) {
  // émojis simples pour navigation visuelle
  var map = {
    AudioEndpoint: '🔊', Camera: '📷', CDROM: '💿', Computer: '🖥️',
    DiskDrive: '💾', Display: '🖼️', FDC: '💾', FloppyDisk: '💾',
    HDC: '🔌', HIDClass: '🖱️', Image: '🖨️', Keyboard: '⌨️',
    MEDIA: '🎵', Monitor: '🖥️', Mouse: '🖱️', Net: '🌐',
    Ports: '🔌', Printer: '🖨️', PrintQueue: '🖨️', Processor: '🧠',
    SCSIAdapter: '💽', SecurityDevices: '🔒', SoftwareComponent: '⚙️',
    SoftwareDevice: '⚙️', System: '⚙️', USB: '🔌', USBDevice: '🔌',
    Volume: '💾', WPD: '📱', Firmware: '⚙️'
  };
  return map[c] || '📦';
}
function statusIcon(d) {
  if (isRealError(d)) return '<span style="color:#e3a900" title="Erreur (problème ' + (d.Problem||'?') + ')">⚠️</span>';
  if ((d.Status || '').toString().toLowerCase() === 'disabled') return '<span style="color:#888" title="Désactivé">⛔</span>';
  if (isGhost(d)) return '<span style="color:#bbb" title="Non connecté (CM_PROB 45)">○</span>';
  return '<span style="color:#2ecc40">●</span>';
}

function fmtBytes(b) {
  if (!b || b <= 0) return '—';
  var units = ['o','Ko','Mo','Go','To'];
  var i = 0;
  while (b >= 1024 && i < units.length - 1) { b /= 1024; i++; }
  return b.toFixed(b >= 100 ? 0 : (b >= 10 ? 1 : 2)) + ' ' + units[i];
}

function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
  });
}

function getJson(url) {
  return new Promise(function (res, rej) {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onload = function () {
      try { res(JSON.parse(xhr.responseText)); }
      catch (e) { rej(new Error('réponse invalide: ' + xhr.responseText.slice(0, 200))); }
    };
    xhr.onerror = function () { rej(new Error('réseau')); };
    xhr.send();
  });
}

function stableHtml(element, html) {
  if (element._maintHtml === html) return false;
  var top = element.scrollTop, left = element.scrollLeft;
  element.innerHTML = html;
  element._maintHtml = html;
  element.scrollTop = top; element.scrollLeft = left;
  return true;
}
function preserveMaintenanceView(update) {
  var ids = ['panel-health', 'healthGroups', 'healthAlertsScroll', 'panel-sessions', 'multiLoginConflictHistory', 'multiLoginEvents'];
  var positions = ids.map(function (id) {
    var el = document.getElementById(id);
    return el ? { id: id, top: el.scrollTop, left: el.scrollLeft } : null;
  });
  var x = window.scrollX, y = window.scrollY;
  update();
  positions.forEach(function (pos) {
    var el = pos && document.getElementById(pos.id);
    if (el) { el.scrollTop = pos.top; el.scrollLeft = pos.left; }
  });
  if (window.scrollX !== x || window.scrollY !== y) window.scrollTo(x, y);
}
function filteredWindowsAgents(onlineOnly, query) {
  var q = String(query || '').toLowerCase().trim();
  return agents.filter(function (a) {
    if (onlineOnly && !a.online) return false;
    if (a.family && a.family !== 'Windows') return false;
    return !q || [a.name, a.mesh, a.os, a.model].some(function (value) {
      return String(value || '').toLowerCase().indexOf(q) !== -1;
    });
  });
}
function updateFleetSummary() {
  var windows = filteredWindowsAgents(false, '');
  document.getElementById('fleetSummary').textContent = windows.length + ' postes Windows';
  document.getElementById('fleetStatus').textContent = windows.filter(function (a) { return a.online; }).length + ' en ligne · inventaire MeshCentral';
}

// ---- Tabs ----
Array.prototype.forEach.call(document.querySelectorAll('.tab'), function (t) {
  t.addEventListener('click', function () {
    Array.prototype.forEach.call(document.querySelectorAll('.tab'), function (x) { x.classList.remove('active'); });
    Array.prototype.forEach.call(document.querySelectorAll('.panel'), function (x) { x.classList.remove('active'); });
    Array.prototype.forEach.call(document.querySelectorAll('.tab'), function (x) { x.setAttribute('aria-selected', String(x === t)); x.tabIndex = x === t ? 0 : -1; });
    t.classList.add('active');
    document.getElementById('panel-' + t.getAttribute('data-tab')).classList.add('active');
  });
  t.addEventListener('keydown', function (event) {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
    var index = tabs.indexOf(t), target;
    if (event.key === 'ArrowRight') target = tabs[(index + 1) % tabs.length];
    if (event.key === 'ArrowLeft') target = tabs[(index + tabs.length - 1) % tabs.length];
    if (event.key === 'Home') target = tabs[0];
    if (event.key === 'End') target = tabs[tabs.length - 1];
    if (target) { event.preventDefault(); target.focus(); target.click(); }
  });
});

// ---- NETTOYAGE ----

function refreshAgents() {
  return getJson(BASE + '&action=agents').then(function (data) {
    if (!data || data.error || !Array.isArray(data.agents)) throw new Error(data && data.error || 'Inventaire invalide');
    agents = data.agents;
    updateFleetSummary();
    renderAgents();
    populateDevNodeSelect();
    populateEvtNodeSelect();
  }).catch(function (e) {
    document.getElementById('agentsBody').innerHTML = '<div class="empty">Erreur: ' + escapeHtml(e.message) + '</div>';
  });
}

function renderAgents() {
  var filtered = filteredWindowsAgents(document.getElementById('onlineOnly').checked, document.getElementById('searchAgents').value);
  var body = document.getElementById('agentsBody');
  document.getElementById('agentsCount').textContent = filtered.length + ' / ' + agents.length;
  if (!filtered.length) { body.innerHTML = '<div class="empty">Aucun poste.</div>'; return; }
  var html = '';
  filtered.forEach(function (a) {
    var sel = !!selected[a.id];
    html += '<div class="row' + (sel ? ' selected' : '') + '" data-id="' + a.id + '">'
      + '<input type="checkbox" ' + (sel ? 'checked' : '') + '>'
      + '<span class="statusDot ' + (a.online ? 'on' : 'off') + '"></span>'
      + '<div class="main">'
      + '<div class="title">' + escapeHtml(a.name) + '</div>'
      + '<div class="sub"><span class="badge">' + escapeHtml(a.mesh || '?') + '</span>'
      + '<span class="badge">' + escapeHtml(a.family || a.os || '?') + '</span>'
      + (a.model ? '<span class="badge" title="Modèle PC">' + escapeHtml(a.model) + '</span>' : '')
      + '</div>'
      + '</div>'
      + '<button class="drvHistBtn cleanHistBtn" data-id="' + a.id + '" title="Historique des nettoyages sur ce poste">Hist</button>'
      + '</div>';
  });
  body.innerHTML = html;
  Array.prototype.forEach.call(body.querySelectorAll('.row'), function (row) {
    row.addEventListener('click', function (e) {
      if (e.target.classList.contains('cleanHistBtn')) return;
      var id = row.getAttribute('data-id');
      selected[id] = !selected[id];
      if (!selected[id]) delete selected[id];
      updateSelCount();
      renderAgents();
    });
  });
  Array.prototype.forEach.call(body.querySelectorAll('.cleanHistBtn'), function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      showCleanHistory(b.getAttribute('data-id'));
    });
  });
}

function showCleanHistory(nodeId) {
  var agent = agents.filter(function (a) { return a.id === nodeId; })[0];
  var modal = document.getElementById('cleanHistModal');
  var title = document.getElementById('cleanHistTitle');
  var body = document.getElementById('cleanHistBody');
  title.textContent = 'Historique nettoyages — ' + ((agent && agent.name) || nodeId.slice(0, 12));
  body.innerHTML = '<div class="empty">Chargement…</div>';
  modal.style.display = 'flex';
  getJson(BASE + '&action=nodeHistory&kind=clean&nodeId=' + encodeURIComponent(nodeId)).then(function (r) {
    if (r.error) { body.innerHTML = '<div class="empty">⚠ ' + escapeHtml(r.error) + '</div>'; return; }
    if (!r.runs || !r.runs.length) { body.innerHTML = '<div class="empty">Aucun nettoyage enregistré pour ce poste.</div>'; return; }
    var rows = r.runs.map(function (h) {
      var statusBadge;
      if (h.status === 'done') statusBadge = '<span class="resCell ok">terminé</span>';
      else if (h.status === 'error') statusBadge = '<span class="resCell ko" title="' + escapeHtml(h.error || '') + '">erreur</span>';
      else if (h.status === 'offline') statusBadge = '<span class="resCell off">offline</span>';
      else if (h.status === 'running') statusBadge = '<span class="resCell run">en cours</span>';
      else if (h.status === 'aborted') statusBadge = '<span class="resCell ko" title="' + escapeHtml(h.error || '') + '">abandonné</span>';
      else statusBadge = escapeHtml(h.status || '?');
      var tasks = (h.tasks || []).join(', ');
      if (h.tasks && h.tasks.indexOf('profiles') >= 0 && h.profileDays) {
        tasks = tasks.replace('profiles', 'profiles >' + h.profileDays + 'j');
      }
      var bytes = (typeof h.totalBytes === 'number') ? fmtBytes(h.totalBytes) : '—';
      return '<tr>'
        + '<td>' + escapeHtml(fmtMtime(h.timestamp)) + '</td>'
        + '<td>' + escapeHtml(tasks) + '</td>'
        + '<td>' + statusBadge + '</td>'
        + '<td>' + bytes + '</td>'
        + '<td style="font-size:11px; color:#666">' + escapeHtml(h.user || '') + '</td>'
        + '</tr>';
    }).join('');
    body.innerHTML = '<table style="width:100%; border-collapse:collapse; font-size:13px">'
      + '<thead><tr style="background:#f5f5f5; text-align:left">'
      + '<th style="padding:6px">Date</th><th style="padding:6px">Tâches</th><th style="padding:6px">Statut</th>'
      + '<th style="padding:6px">Libéré</th><th style="padding:6px">Par</th>'
      + '</tr></thead><tbody>' + rows + '</tbody></table>';
  }).catch(function (e) {
    body.innerHTML = '<div class="empty">⚠ ' + escapeHtml(e.message) + '</div>';
  });
}

function updateSelCount() {
  var n = Object.keys(selected).length;
  document.getElementById('selCount').textContent = n + ' poste(s) sélectionné(s)';
  document.getElementById('runBtn').disabled = !n || !selectedTasks().length;
}

function selectedTasks() {
  return Array.prototype.filter.call(
    document.querySelectorAll('.taskCheck'),
    function (c) { return c.checked; }
  ).map(function (c) { return c.value; });
}

function runClean() {
  var nodes = Object.keys(selected);
  var tasks = selectedTasks();
  if (!nodes.length || !tasks.length) return;
  var profileDays = parseInt(document.getElementById('profileDays').value, 10) || 90;
  var lines = ['Lancer sur ' + nodes.length + ' poste(s) :'];
  tasks.forEach(function (t) {
    if (t === 'temp') lines.push('  • Fichiers temporaires');
    else if (t === 'browser') lines.push('  • Caches navigateurs');
    else if (t === 'dism') lines.push('  • DISM / Windows.old (10-30 min)');
    else if (t === 'profiles') lines.push('  • Profils utilisateurs inactifs depuis plus de ' + profileDays + ' jours → SUPPRESSION');
    else lines.push('  • ' + t);
  });
  if (tasks.indexOf('profiles') >= 0) {
    lines.push('');
    lines.push('⚠ La suppression de profils est irréversible.');
  }
  if (!window.confirm(lines.join('\n'))) return;
  var payload = JSON.stringify({ nodes: nodes, tasks: tasks, profileDays: profileDays });
  getJson(BASE + '&action=run&payload=' + encodeURIComponent(payload)).then(function (r) {
    if (r.error) { alert('Erreur: ' + r.error); return; }
    currentRunId = r.runId;
    try { localStorage.setItem('maintctl_currentRunId', r.runId); } catch (_) {}
    document.getElementById('results').style.display = 'block';
    pollRun();
  }).catch(function (e) { alert('Erreur: ' + e.message); });
}

function pollRun() {
  if (!currentRunId) return;
  getJson(BASE + '&action=runStatus&runId=' + encodeURIComponent(currentRunId)).then(function (run) {
    if (run.error) {
      // Run inconnu (probablement nettoyé côté serveur) → on oublie
      try { localStorage.removeItem('maintctl_currentRunId'); } catch (_) {}
      currentRunId = null;
      document.getElementById('results').style.display = 'none';
      return;
    }
    renderResults(run);
    var allDone = Object.values(run.results).every(function (r) {
      return r.status === 'done' || r.status === 'error' || r.status === 'offline' || r.status === 'aborted';
    });
    if (allDone) {
      // Plus de polling, mais on garde l'affichage pour que l'utilisateur voie le résultat
      try { localStorage.removeItem('maintctl_currentRunId'); } catch (_) {}
    } else {
      clearTimeout(pollTimer);
      pollTimer = setTimeout(pollRun, 3000);
    }
  }).catch(function () {
    clearTimeout(pollTimer);
    pollTimer = setTimeout(pollRun, 5000);
  });
}

function restoreCleanRun() {
  try {
    var stored = localStorage.getItem('maintctl_currentRunId');
    if (!stored) return;
    currentRunId = stored;
    document.getElementById('results').style.display = 'block';
    pollRun();
  } catch (_) {}
}

function renderResults(run) {
  var tbody = document.getElementById('resultsBody');
  var rows = '';
  var byId = {};
  agents.forEach(function (a) { byId[a.id] = a; });
  Object.keys(run.results).forEach(function (nid) {
    var r = run.results[nid];
    var name = (byId[nid] && byId[nid].name) || nid.slice(0, 12);
    var tasks = r.tasks || {};
    function cell(k) {
      var t = tasks[k];
      if (!t && r.status === 'running') return '<span class="resCell run">…</span>';
      if (!t) return '<span class="resCell off">—</span>';
      var cls = t.ok ? 'ok' : 'ko';
      return '<span class="resCell ' + cls + '">' + fmtBytes(t.bytes) + '</span>';
    }
    var statusCell;
    if (r.status === 'running') statusCell = '<span class="resCell run">en cours</span>';
    else if (r.status === 'done') statusCell = '<span class="resCell ok">terminé</span>';
    else if (r.status === 'offline') statusCell = '<span class="resCell off">offline</span>';
    else if (r.status === 'aborted') statusCell = '<span class="resCell ko" title="' + escapeHtml(r.error || '') + '">abandonné</span>';
    else statusCell = '<span class="resCell ko">erreur</span>';
    rows += '<tr><td>' + escapeHtml(name) + '</td><td>' + statusCell + '</td>'
      + '<td>' + cell('temp') + '</td><td>' + cell('browser') + '</td>'
      + '<td>' + cell('dism') + '</td><td>' + cell('profiles') + '</td>'
      + '<td><b>' + fmtBytes(r.totalBytes) + '</b></td></tr>';
  });
  stableHtml(tbody, rows);
}

// ---- PÉRIPHÉRIQUES ----

function populateDevNodeSelect() {
  var sel = document.getElementById('devNodeSel');
  var prev = sel.value;
  var opts = '<option value="">— sélectionner —</option>';
  agents.filter(function (a) {
    return a.online && (!a.family || a.family === 'Windows');
  }).forEach(function (a) {
    opts += '<option value="' + escapeHtml(a.id) + '">' + escapeHtml(a.name) + ' (' + escapeHtml(a.mesh || '?') + ')</option>';
  });
  sel.innerHTML = opts;
  if (prev) sel.value = prev;
}

function loadDevices(force) {
  var nid = document.getElementById('devNodeSel').value;
  if (!nid) { alert('Choisis un poste.'); return; }
  document.getElementById('devListBody').innerHTML = '<div class="empty">Récupération en cours… (jusqu\'à 150s)</div>';
  document.getElementById('devSummary').style.display = 'none';
  getJson(BASE + '&action=devList&nodeId=' + encodeURIComponent(nid) + (force ? '&force=1' : ''))
    .then(function (r) {
      if (!r.ok) {
        document.getElementById('devListBody').innerHTML = '<div class="empty">Erreur : ' + escapeHtml(r.error || '?') + '</div>';
        return;
      }
      allDevices = r.devices || [];
      renderDevSummary(r.cached, r.lastCheck);
      renderDevices();
    })
    .catch(function (e) {
      document.getElementById('devListBody').innerHTML = '<div class="empty">Erreur réseau: ' + escapeHtml(e.message) + '</div>';
    });
}

// CM_PROB 45 = "currently not connected" → fantômes (USB jamais débranchées de façon
// propre). On les distingue dans le résumé pour ne pas crier au feu.
function isGhost(d) { return d && d.Problem === 45; }
function isRealError(d) {
  var s = (d.Status || '').toString().toLowerCase();
  if (isGhost(d)) return false;
  return s === 'error' || s === 'degraded' || (d.Problem && d.Problem !== 0);
}
function renderDevSummary(cached, lastCheck) {
  var total = allDevices.length;
  var present = allDevices.filter(function (d) { return !isGhost(d); }).length;
  var ghosts = total - present;
  var errors = allDevices.filter(isRealError).length;
  var disabled = allDevices.filter(function (d) { return (d.Status || '').toString().toLowerCase() === 'disabled'; }).length;
  var info = cached ? ('cache, ' + new Date(lastCheck).toLocaleTimeString()) : 'données fraîches';
  var html = '<span class="num">' + present + '</span>présents&nbsp;&nbsp;'
    + '<span class="num" style="color:#721c24">' + errors + '</span>en erreur&nbsp;&nbsp;'
    + '<span class="num" style="color:#383d41">' + disabled + '</span>désactivés&nbsp;&nbsp;'
    + '<span class="num" style="color:#aaa">' + ghosts + '</span>absents (CM_PROB 45)'
    + '<span style="float:right; color:#888; font-size:11px">' + info + '</span>';
  var s = document.getElementById('devSummary');
  s.innerHTML = html;
  s.style.display = 'block';
}

function renderDevices() {
  var q = (document.getElementById('devFilter').value || '').toLowerCase();
  var errorsOnly = document.getElementById('devErrorsOnly').checked;
  var showGhosts = document.getElementById('devShowGhosts').checked;
  var showHidden = document.getElementById('devShowHidden').checked;

  var list = allDevices.slice();
  // Pseudo-devices internes (HTREE\ROOT\0, etc.) : pas de classe, pas de nom,
  // jamais affichés dans le vrai gestionnaire.
  list = list.filter(function (d) {
    if (d.Class || d.FriendlyName) return true;
    return false;
  });
  if (!showGhosts) list = list.filter(function (d) { return !isGhost(d); });
  if (!showHidden) list = list.filter(function (d) { return !HIDDEN_BY_DEFAULT_CLASSES[d.Class]; });
  if (errorsOnly) list = list.filter(isRealError);
  if (q) {
    list = list.filter(function (d) {
      return ['Status','Class','FriendlyName','InstanceId','Manufacturer','ProblemDescription']
        .some(function (k) { return String(d[k] || '').toLowerCase().indexOf(q) >= 0; });
    });
  }

  // Group par Class
  var groups = {};
  list.forEach(function (d) {
    var c = d.Class || '(sans classe)';
    if (!groups[c]) groups[c] = [];
    groups[c].push(d);
  });
  var classNames = Object.keys(groups).sort(function (a, b) {
    return classLabel(a).localeCompare(classLabel(b), 'fr');
  });

  if (!classNames.length) {
    document.getElementById('devListBody').innerHTML = '<div class="empty">aucun</div>';
    return;
  }

  // Nœud racine = nom du poste (label de l'option select).
  var sel = document.getElementById('devNodeSel');
  var rootName = (sel.options[sel.selectedIndex] && sel.options[sel.selectedIndex].text) || 'Ordinateur';
  // Retire le suffixe " (salle)" si présent pour ne garder que le nom du poste.
  rootName = rootName.replace(/\s*\(.*\)\s*$/, '');

  // Auto-expand : classes avec erreur ouvertes par défaut. Si l'utilisateur a
  // manuellement plié/déplié, on respecte son choix (devCollapsed).
  var html = classNames.map(function (c) {
    var devs = groups[c].slice().sort(function (a, b) {
      return String(a.FriendlyName || '').localeCompare(String(b.FriendlyName || ''), 'fr');
    });
    var nErr = devs.filter(isRealError).length;
    var userCollapsed = (c in devCollapsed) ? devCollapsed[c] : (nErr === 0);
    var caret = userCollapsed ? '▶' : '▼';

    var items = devs.map(function (d) {
      var cls = ['devItem'];
      if (isRealError(d)) cls.push('err');
      if ((d.Status || '').toString().toLowerCase() === 'disabled') cls.push('disabled');
      if (isGhost(d)) cls.push('ghost');
      var probTxt = '';
      if (isRealError(d)) {
        probTxt = ' <span class="problem">' + escapeHtml(d.ProblemDescription || ('CM_PROB ' + d.Problem)) + '</span>';
      }
      var manu = d.Manufacturer ? (' — ' + escapeHtml(d.Manufacturer)) : '';
      return '<div class="' + cls.join(' ') + '" title="' + escapeHtml(d.InstanceId || '') + '">'
        + '<span class="icon">' + statusIcon(d) + '</span>'
        + '<span class="name">' + escapeHtml(d.FriendlyName || '(sans nom)') + '<span class="meta">' + manu + '</span></span>'
        + probTxt
        + '</div>';
    }).join('');

    return '<div class="devClass" data-class="' + escapeHtml(c) + '">'
      + '<div class="devClassHdr">'
      + '<span class="caret">' + caret + '</span>'
      + '<span class="icon">' + classIcon(c) + '</span>'
      + '<span class="name">' + escapeHtml(classLabel(c)) + '</span>'
      + '<span class="count">(' + devs.length + ')</span>'
      + (nErr ? '<span class="badge-err">' + nErr + ' en erreur</span>' : '')
      + '</div>'
      + '<div class="devChildren' + (userCollapsed ? ' collapsed' : '') + '">' + items + '</div>'
      + '</div>';
  }).join('');

  // Wrap dans une racine "nom du poste" comme Windows DM.
  var rootHtml = '<div class="devRoot">'
    + '<span class="caret">▼</span>'
    + '<span class="icon">🖥️</span>'
    + '<span class="name">' + escapeHtml(rootName) + '</span>'
    + '</div>'
    + '<div class="devRootChildren">' + html + '</div>';

  document.getElementById('devListBody').innerHTML = rootHtml;

  // Toggle plier/déplier
  Array.prototype.forEach.call(document.querySelectorAll('.devClassHdr'), function (h) {
    h.addEventListener('click', function () {
      var c = h.parentNode.getAttribute('data-class');
      var children = h.parentNode.querySelector('.devChildren');
      var nowCollapsed = !children.classList.contains('collapsed');
      children.classList.toggle('collapsed');
      h.querySelector('.caret').textContent = nowCollapsed ? '▶' : '▼';
      devCollapsed[c] = nowCollapsed;
    });
  });

  // Clic sur un device → modal détails
  Array.prototype.forEach.call(document.querySelectorAll('.devItem'), function (it) {
    it.addEventListener('click', function () {
      var iid = it.getAttribute('title');
      var d = allDevices.find(function (x) { return x.InstanceId === iid; });
      if (d) openDevModal(d);
    });
  });
}

// ---- MODAL DETAILS DEVICE ----
var modalDev = null;

function openDevModal(d) {
  modalDev = d;
  document.getElementById('devModalTitle').innerHTML =
    statusIcon(d) + ' ' + escapeHtml(d.FriendlyName || '(sans nom)');
  document.getElementById('devModalSub').textContent =
    classLabel(d.Class) + (d.Manufacturer ? ' — ' + d.Manufacturer : '');

  var prob = document.getElementById('devModalProb');
  if (d.Problem) {
    prob.className = 'probBox' + (isRealError(d) ? ' err' : '');
    prob.style.display = 'block';
    prob.innerHTML = '<b>CM_PROB ' + d.Problem + '</b> — ' + escapeHtml(problemFr(d.Problem))
      + (d.ProblemDescription ? '<br><span style="color:#555">' + escapeHtml(d.ProblemDescription) + '</span>' : '');
  } else {
    prob.style.display = 'none';
  }

  // Détails de base (depuis devList)
  document.getElementById('devModalBody').innerHTML = baseDetailsHtml(d)
    + '<div class="empty" id="devLazyLoading">Chargement détails complets…</div>';

  // Hide action result
  document.getElementById('devModalResult').className = 'actionResult';
  document.getElementById('devModalResult').textContent = '';

  document.getElementById('devModal').classList.add('show');

  // Lazy load détails (HardwareIDs, driver…)
  var nid = document.getElementById('devNodeSel').value;
  if (!nid) return;
  var url = BASE + '&action=devDetails&nodeId=' + encodeURIComponent(nid)
    + '&instanceId=' + encodeURIComponent(d.InstanceId);
  getJson(url).then(function (r) {
    var lazy = document.getElementById('devLazyLoading');
    if (lazy) lazy.parentNode.removeChild(lazy);
    if (!r.ok) {
      document.getElementById('devModalBody').insertAdjacentHTML('beforeend',
        '<div class="empty">Détails complets indispo : ' + escapeHtml(r.error || '?') + '</div>');
      return;
    }
    document.getElementById('devModalBody').insertAdjacentHTML('beforeend', fullDetailsHtml(r.details));
  }).catch(function (e) {
    var lazy = document.getElementById('devLazyLoading');
    if (lazy) lazy.textContent = 'Erreur : ' + e.message;
  });
}

function baseDetailsHtml(d) {
  function row(k, v) {
    if (!v) return '';
    return '<div class="field"><div class="k">' + escapeHtml(k) + '</div><div class="v">' + escapeHtml(v) + '</div></div>';
  }
  return row('Statut', d.Status)
    + row('Classe', classLabel(d.Class))
    + row('Fabricant', d.Manufacturer)
    + row('Instance ID', d.InstanceId);
}

function fullDetailsHtml(x) {
  if (!x) return '';
  function row(k, v) {
    if (!v) return '';
    return '<div class="field"><div class="k">' + escapeHtml(k) + '</div><div class="v">' + escapeHtml(v) + '</div></div>';
  }
  function rowIds(k, arr) {
    if (!arr || !arr.length) return '';
    return '<div class="field"><div class="k">' + escapeHtml(k) + '</div><div class="v ids">' + arr.map(escapeHtml).join('\n') + '</div></div>';
  }
  return '<div style="margin-top:8px; border-top:1px solid #eee; padding-top:8px">'
    + row('Service', x.Service)
    + row('Pilote (desc)', x.DriverDesc)
    + row('Fournisseur', x.DriverProvider)
    + row('Version', x.DriverVersion)
    + row('Date pilote', x.DriverDate)
    + row('INF', x.DriverInfPath)
    + row('Emplacement', x.LocationInfo)
    + row('PDO', x.PdoName)
    + rowIds('Hardware IDs', x.HardwareIds)
    + rowIds('Compatible IDs', x.CompatibleIds)
    + '</div>';
}

function runDevAction(action) {
  if (!modalDev) return;
  var nid = document.getElementById('devNodeSel').value;
  if (!nid) return;
  var instanceId = modalDev.InstanceId;
  var confirmMsg = {
    scan: 'Lancer un rescan PnP (pnputil /scan-devices) sur ce poste ?',
    enable: 'Réactiver "' + (modalDev.FriendlyName || instanceId) + '" ?',
    disable: 'Désactiver "' + (modalDev.FriendlyName || instanceId) + '" ?\n\nLe périphérique ne fonctionnera plus tant qu\'il n\'est pas réactivé.',
    remove: 'Désinstaller "' + (modalDev.FriendlyName || instanceId) + '" ?\n\nWindows tentera de le redécouvrir au prochain branchement ou reboot.'
  }[action];
  if (!window.confirm(confirmMsg)) return;
  var res = document.getElementById('devModalResult');
  res.className = 'actionResult show';
  res.textContent = 'Action en cours…';
  var url = BASE + '&action=devAction&nodeId=' + encodeURIComponent(nid)
    + '&devAction=' + encodeURIComponent(action)
    + '&instanceId=' + encodeURIComponent(action === 'scan' ? '' : instanceId);
  getJson(url).then(function (r) {
    res.className = 'actionResult show ' + (r.ok ? 'ok' : 'ko');
    res.textContent = (r.ok ? '✓ ' : '✗ ') + (r.action || action)
      + (r.log ? '\n\n' + r.log : (r.error ? '\n\n' + r.error : ''));
  }).catch(function (e) {
    res.className = 'actionResult show ko';
    res.textContent = '✗ ' + e.message;
  });
}

document.getElementById('devModalClose').addEventListener('click', function () {
  document.getElementById('devModal').classList.remove('show');
  modalDev = null;
});
document.getElementById('devModal').addEventListener('click', function (e) {
  if (e.target === this) {
    this.classList.remove('show');
    modalDev = null;
  }
});
document.getElementById('devActScan').addEventListener('click', function () { runDevAction('scan'); });
document.getElementById('devActEnable').addEventListener('click', function () { runDevAction('enable'); });
document.getElementById('devActDisable').addEventListener('click', function () { runDevAction('disable'); });
document.getElementById('devActRemove').addEventListener('click', function () { runDevAction('remove'); });

// Wire up

document.getElementById('refreshBtn').addEventListener('click', refreshAgents);
document.getElementById('runBtn').addEventListener('click', runClean);
Array.prototype.forEach.call(document.querySelectorAll('.taskCheck'), function (input) { input.addEventListener('change', updateSelCount); });
document.getElementById('selectAllBtn').addEventListener('click', function () {
  filteredWindowsAgents(document.getElementById('onlineOnly').checked, document.getElementById('searchAgents').value).forEach(function (a) { selected[a.id] = true; });
  updateSelCount(); renderAgents();
});
document.getElementById('selectNoneBtn').addEventListener('click', function () {
  selected = {}; updateSelCount(); renderAgents();
});
document.getElementById('searchAgents').addEventListener('input', renderAgents);
document.getElementById('onlineOnly').addEventListener('change', renderAgents);

// ---- DRIVERS ----
var availableDrivers = [];
var selectedDriver = '';
var drvSelected = {}; // sélection propre à l'onglet Drivers (évite confusion avec Nettoyage)
var drvRunId = null;
var drvPollTimer = null;

function fmtMtime(ms) {
  if (!ms) return '';
  var d = new Date(ms);
  return d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
}

function renderDrvAgents() {
  var filtered = filteredWindowsAgents(document.getElementById('drvOnlineOnly').checked, document.getElementById('drvSearchAgents').value);
  var body = document.getElementById('drvAgentsBody');
  document.getElementById('drvAgentsCount').textContent = filtered.length + ' / ' + agents.length;
  if (!filtered.length) { body.innerHTML = '<div class="empty">Aucun poste.</div>'; return; }
  var html = '';
  filtered.forEach(function (a) {
    var sel = !!drvSelected[a.id];
    html += '<div class="row' + (sel ? ' selected' : '') + '" data-id="' + a.id + '">'
      + '<input type="checkbox" ' + (sel ? 'checked' : '') + '>'
      + '<span class="statusDot ' + (a.online ? 'on' : 'off') + '"></span>'
      + '<div class="main">'
      + '<div class="title">' + escapeHtml(a.name) + '</div>'
      + '<div class="sub"><span class="badge">' + escapeHtml(a.mesh || '?') + '</span>'
      + '<span class="badge">' + escapeHtml(a.family || a.os || '?') + '</span>'
      + (a.model ? '<span class="badge" title="Modèle PC">' + escapeHtml(a.model) + '</span>' : '')
      + '</div>'
      + '</div>'
      + '<button class="drvHistBtn" data-id="' + a.id + '" title="Historique des installations sur ce poste">Hist</button>'
      + '</div>';
  });
  body.innerHTML = html;
  Array.prototype.forEach.call(body.querySelectorAll('.row'), function (row) {
    row.addEventListener('click', function (e) {
      if (e.target.classList.contains('drvHistBtn')) return;
      var id = row.getAttribute('data-id');
      drvSelected[id] = !drvSelected[id];
      if (!drvSelected[id]) delete drvSelected[id];
      updateDrvUi();
      renderDrvAgents();
    });
  });
  Array.prototype.forEach.call(body.querySelectorAll('.drvHistBtn'), function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      showDrvHistory(b.getAttribute('data-id'));
    });
  });
}

function showDrvHistory(nodeId) {
  var agent = agents.filter(function (a) { return a.id === nodeId; })[0];
  var modal = document.getElementById('drvHistModal');
  var title = document.getElementById('drvHistTitle');
  var body = document.getElementById('drvHistBody');
  title.textContent = 'Historique drivers — ' + ((agent && agent.name) || nodeId.slice(0, 12));
  body.innerHTML = '<div class="empty">Chargement…</div>';
  modal.style.display = 'flex';
  getJson(BASE + '&action=nodeHistory&kind=driver&nodeId=' + encodeURIComponent(nodeId)).then(function (r) {
    if (r.error) { body.innerHTML = '<div class="empty">⚠ ' + escapeHtml(r.error) + '</div>'; return; }
    if (!r.runs || !r.runs.length) { body.innerHTML = '<div class="empty">Aucune installation enregistrée pour ce poste.</div>'; return; }
    var rows = r.runs.map(function (h) {
      var statusBadge;
      if (h.status === 'done') statusBadge = '<span class="resCell ok">terminé</span>';
      else if (h.status === 'error') statusBadge = '<span class="resCell ko" title="' + escapeHtml(h.error || '') + '">erreur</span>';
      else if (h.status === 'offline') statusBadge = '<span class="resCell off">offline</span>';
      else if (h.status === 'running') statusBadge = '<span class="resCell run">en cours</span>';
      else if (h.status === 'aborted') statusBadge = '<span class="resCell ko" title="' + escapeHtml(h.error || '') + '">abandonné</span>';
      else statusBadge = escapeHtml(h.status || '?');
      var inst = (typeof h.installed === 'number') ? String(h.installed) : '—';
      var err = (typeof h.errors === 'number' && h.errors > 0) ? ' (' + h.errors + ' err)' : '';
      var reboot = h.rebootRequired ? 'recommandé' : '—';
      return '<tr>'
        + '<td>' + escapeHtml(fmtMtime(h.timestamp)) + '</td>'
        + '<td>' + escapeHtml(h.driver || '?') + '</td>'
        + '<td>' + statusBadge + '</td>'
        + '<td>' + inst + err + '</td>'
        + '<td>' + reboot + '</td>'
        + '<td style="font-size:11px; color:#666">' + escapeHtml(h.user || '') + '</td>'
        + '</tr>';
    }).join('');
    body.innerHTML = '<table style="width:100%; border-collapse:collapse; font-size:13px">'
      + '<thead><tr style="background:#f5f5f5; text-align:left">'
      + '<th style="padding:6px">Date</th><th style="padding:6px">Driver</th><th style="padding:6px">Statut</th>'
      + '<th style="padding:6px">Installés</th><th style="padding:6px">Redémarrage</th><th style="padding:6px">Par</th>'
      + '</tr></thead><tbody>' + rows + '</tbody></table>';
  }).catch(function (e) {
    body.innerHTML = '<div class="empty">⚠ ' + escapeHtml(e.message) + '</div>';
  });
}

function updateDrvUi() {
  var n = Object.keys(drvSelected).length;
  document.getElementById('drvSelCount').textContent = n + ' poste(s) sélectionné(s)';
  document.getElementById('drvInstallBtn').disabled = !(n && selectedDriver);
}

function refreshDrivers() {
  document.getElementById('drvList').innerHTML = '<div class="empty">Chargement…</div>';
  return getJson(BASE + '&action=driverList').then(function (r) {
    availableDrivers = r.drivers || [];
    var info = 'Source : ' + (r.dir || '?');
    if (r.error) info += ' — ⚠ ' + r.error;
    document.getElementById('drvDirInfo').textContent = info;
    document.getElementById('drvCount').textContent = availableDrivers.length;
    renderDrivers();
  }).catch(function (e) {
    document.getElementById('drvList').innerHTML = '<div class="empty">Erreur: ' + escapeHtml(e.message) + '</div>';
  });
}

function renderDrivers() {
  var body = document.getElementById('drvList');
  if (!availableDrivers.length) {
    body.innerHTML = '<div class="empty">Aucun .zip dans le dossier configuré. '
      + 'Zippe un dossier de pilote (.inf + fichiers associés) et dépose le .zip sur le NAS '
      + '(voir maintctl-config.json côté serveur).</div>';
    return;
  }
  var html = '';
  availableDrivers.forEach(function (d) {
    var sel = (selectedDriver === d.name);
    var typeBadge = (d.type === 'folder')
      ? ('<span class="badge">dossier · ' + d.fileCount + ' fichier' + (d.fileCount > 1 ? 's' : '') + (d.hasInf ? '' : ' — pas de .inf') + '</span>')
      : '<span class="badge">.zip</span>';
    html += '<div class="row' + (sel ? ' selected' : '') + '" data-name="' + escapeHtml(d.name) + '">'
      + '<input type="radio" name="drvPick" ' + (sel ? 'checked' : '') + '>'
      + '<div class="main">'
      + '<div class="title">' + escapeHtml(d.name) + '</div>'
      + '<div class="sub">' + typeBadge
      + '<span class="badge">' + fmtBytes(d.size) + '</span>'
      + '<span class="badge">' + escapeHtml(fmtMtime(d.mtime)) + '</span></div>'
      + '</div>'
      + '<button class="drvDelBtn" data-name="' + escapeHtml(d.name) + '" title="Supprimer du NAS">✕</button>'
      + '</div>';
  });
  body.innerHTML = html;
  Array.prototype.forEach.call(body.querySelectorAll('.row'), function (row) {
    row.addEventListener('click', function (e) {
      if (e.target.classList.contains('drvDelBtn')) return; // delete géré séparément
      selectedDriver = row.getAttribute('data-name');
      updateDrvUi();
      renderDrivers();
    });
  });
  Array.prototype.forEach.call(body.querySelectorAll('.drvDelBtn'), function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      var name = b.getAttribute('data-name');
      if (!window.confirm('Supprimer ' + name + ' du NAS ?\n\nCela ne touche pas les postes où ce pilote est déjà installé.')) return;
      getJson(BASE + '&action=deleteDriver&name=' + encodeURIComponent(name)).then(function (r) {
        if (r.error) { alert('Erreur: ' + r.error); return; }
        if (selectedDriver === name) { selectedDriver = ''; updateDrvUi(); }
        refreshDrivers();
      });
    });
  });
}

// Upload de N fichiers d'un pilote dans un sous-dossier sur le NAS.
// Demande à l'utilisateur le nom du pack, puis upload séquentiel.
function uploadDriverFiles(fileList) {
  var status = document.getElementById('drvUploadStatus');
  var files = Array.prototype.slice.call(fileList || []);
  if (!files.length) return;
  // Vérifie qu'il y a au moins un .inf
  var hasInf = files.some(function (f) { return /\.inf$/i.test(f.name); });
  if (!hasInf) {
    if (!window.confirm('Aucun .inf dans la sélection. Continuer quand même ? (l\'installation pnputil échouera sans .inf)')) return;
  }
  // Suggère un nom de pack à partir du premier .inf ou du dossier
  var defaultName = '';
  var infFile = files.find(function (f) { return /\.inf$/i.test(f.name); });
  if (infFile) defaultName = infFile.name.replace(/\.inf$/i, '');
  defaultName = defaultName.replace(/[^a-zA-Z0-9._-]+/g, '_');
  var pack = window.prompt(
    'Nom du pack de pilotes ?\n\n' + files.length + ' fichier(s) seront déposés dans driversDir/<nom>/ sur le NAS.\n'
    + 'Autorisé : lettres, chiffres, . _ - (pas d\'espace ni d\'accent).',
    defaultName
  );
  if (!pack) return;
  pack = pack.trim();
  if (!/^[a-zA-Z0-9._-]+$/.test(pack)) {
    status.textContent = '⚠ nom de pack invalide';
    return;
  }
  // Vérifie les noms de fichiers
  var invalid = files.filter(function (f) { return !/^[a-zA-Z0-9._-]+\.[a-zA-Z0-9]+$/.test(f.name); });
  if (invalid.length) {
    status.textContent = '⚠ noms invalides : ' + invalid.map(function (f) { return f.name; }).join(', ');
    return;
  }
  var overwrite = 0;
  if (availableDrivers.some(function (d) { return d.name === pack; })) {
    if (!window.confirm('Pack "' + pack + '" existe déjà sur le NAS. Ajouter/remplacer les fichiers dedans ?')) return;
    overwrite = 1;
  }
  var done = 0;
  var total = files.length;
  function uploadOne(f) {
    status.textContent = 'Upload ' + (done + 1) + '/' + total + ' : ' + f.name + ' (' + fmtBytes(f.size) + ')…';
    return getJson(BASE + '&action=requestDriverUploadToken&pack=' + encodeURIComponent(pack)
        + '&filename=' + encodeURIComponent(f.name) + '&overwrite=' + overwrite)
      .then(function (r) {
        if (r.error) throw new Error(r.error);
        return fetch(r.url, {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/octet-stream' },
          body: f
        }).then(function (resp) { return resp.json(); });
      })
      .then(function (r2) {
        if (r2.error) throw new Error(r2.error);
        done++;
      });
  }
  // Série pour pas saturer le NAS
  var chain = Promise.resolve();
  files.forEach(function (f) {
    chain = chain.then(function () { return uploadOne(f); });
  });
  chain.then(function () {
    status.textContent = '✓ ' + total + ' fichier(s) déposés dans pack "' + pack + '"';
    refreshDrivers();
    setTimeout(function () { status.textContent = ''; }, 6000);
  }).catch(function (e) {
    status.textContent = '⚠ ' + e.message + ' (après ' + done + '/' + total + ')';
    refreshDrivers();
  });
}

function uploadDriver(file) {
  var status = document.getElementById('drvUploadStatus');
  if (!file) return;
  if (!/\.zip$/i.test(file.name)) { status.textContent = '⚠ .zip uniquement'; return; }
  if (!/^[a-zA-Z0-9._-]+\.zip$/.test(file.name)) {
    status.textContent = '⚠ nom invalide (autorisé : [a-zA-Z0-9._-]+.zip — pas d\'espace ni d\'accent)';
    return;
  }
  var overwrite = 0;
  if (availableDrivers.some(function (d) { return d.name === file.name; })) {
    if (!window.confirm(file.name + ' existe déjà sur le NAS. Le remplacer ?')) return;
    overwrite = 1;
  }
  status.textContent = 'Demande de token…';
  getJson(BASE + '&action=requestDriverUploadToken&filename=' + encodeURIComponent(file.name) + '&overwrite=' + overwrite)
    .then(function (r) {
      if (r.error) { status.textContent = '⚠ ' + r.error; return null; }
      status.textContent = 'Upload (' + fmtBytes(file.size) + ')…';
      return fetch(r.url, {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/octet-stream' },
        body: file
      }).then(function (resp) { return resp.json(); });
    })
    .then(function (r2) {
      if (!r2) return;
      if (r2.error) { status.textContent = '⚠ ' + r2.error; return; }
      status.textContent = '✓ ' + r2.filename + ' (' + fmtBytes(r2.size) + ')';
      refreshDrivers();
      setTimeout(function () { status.textContent = ''; }, 5000);
    })
    .catch(function (e) { status.textContent = '⚠ ' + e.message; });
}

function runDriverInstall() {
  var nodes = Object.keys(drvSelected);
  if (!nodes.length || !selectedDriver) return;
  var msg = 'Installer "' + selectedDriver + '" sur ' + nodes.length + ' poste(s) ?\n\n'
    + 'pnputil /add-driver /install /subdirs sera lancé. '
    + 'Certains drivers exigent un redémarrage pour être effectifs.';
  if (!window.confirm(msg)) return;
  var payload = JSON.stringify({ nodes: nodes, driver: selectedDriver });
  getJson(BASE + '&action=driverInstall&payload=' + encodeURIComponent(payload)).then(function (r) {
    if (r.error) { alert('Erreur: ' + r.error); return; }
    drvRunId = r.runId;
    try { localStorage.setItem('maintctl_drvRunId', r.runId); } catch (_) {}
    document.getElementById('drvResults').style.display = 'block';
    pollDrvRun();
  }).catch(function (e) { alert('Erreur: ' + e.message); });
}

function restoreDrvRun() {
  try {
    var stored = localStorage.getItem('maintctl_drvRunId');
    if (!stored) return;
    drvRunId = stored;
    document.getElementById('drvResults').style.display = 'block';
    pollDrvRun();
  } catch (_) {}
}

function pollDrvRun() {
  if (!drvRunId) return;
  getJson(BASE + '&action=runStatus&runId=' + encodeURIComponent(drvRunId)).then(function (run) {
    if (run.error) {
      try { localStorage.removeItem('maintctl_drvRunId'); } catch (_) {}
      drvRunId = null;
      document.getElementById('drvResults').style.display = 'none';
      return;
    }
    renderDrvResults(run);
    var allDone = Object.values(run.results).every(function (r) {
      return r.status === 'done' || r.status === 'error' || r.status === 'offline' || r.status === 'aborted';
    });
    if (allDone) {
      try { localStorage.removeItem('maintctl_drvRunId'); } catch (_) {}
    } else {
      clearTimeout(drvPollTimer);
      drvPollTimer = setTimeout(pollDrvRun, 3000);
    }
  }).catch(function () {
    clearTimeout(drvPollTimer);
    drvPollTimer = setTimeout(pollDrvRun, 5000);
  });
}

function renderDrvResults(run) {
  var tbody = document.getElementById('drvResultsBody');
  var byId = {};
  agents.forEach(function (a) { byId[a.id] = a; });
  var rows = '';
  Object.keys(run.results).forEach(function (nid) {
    var r = run.results[nid];
    var name = (byId[nid] && byId[nid].name) || nid.slice(0, 12);
    var statusCell;
    if (r.status === 'running') statusCell = '<span class="resCell run">en cours</span>';
    else if (r.status === 'done') statusCell = '<span class="resCell ok">terminé</span>';
    else if (r.status === 'offline') statusCell = '<span class="resCell off">offline</span>';
    else if (r.status === 'aborted') statusCell = '<span class="resCell ko" title="' + escapeHtml(r.error || '') + '">abandonné</span>';
    else statusCell = '<span class="resCell ko" title="' + escapeHtml(r.error || '') + '">erreur</span>';
    var step = r.step || '';
    var installed = (typeof r.installed === 'number') ? String(r.installed) : '—';
    var reboot = r.rebootRequired
      ? '<span class="resCell run" title="pnputil a renvoyé 3010 — le poste n\'a PAS été redémarré, mais un redémarrage manuel est conseillé pour finaliser certains pilotes">recommandé</span>'
      : (r.status === 'done' ? '<span class="resCell ok">non</span>' : '—');
    rows += '<tr><td>' + escapeHtml(name) + '</td>'
      + '<td>' + statusCell + '</td>'
      + '<td>' + escapeHtml(step) + (r.error && (r.status === 'error' || r.status === 'aborted') ? '<div style="color:#721c24; font-size:11px">' + escapeHtml(r.error) + '</div>' : '') + '</td>'
      + '<td>' + installed + '</td>'
      + '<td>' + reboot + '</td></tr>';
  });
  stableHtml(tbody, rows);
}

