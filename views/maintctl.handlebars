// ============================ SANTÉ ============================
var healthData = null;
var healthTimer = null;
var healthLoading = null, healthFetchedAt = 0;
var HEALTH_POLL_MS = 5 * 60 * 1000;

function fmtBoot(ms) {
  if (!ms) return '—';
  var d = new Date(ms);
  return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth()+1)).slice(-2) + '/' + d.getFullYear()
       + ' ' + ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
}

function filteredHealthAgents() {
  var q = document.getElementById('healthSearch').value.toLowerCase().trim();
  var room = document.getElementById('healthRoom').value;
  return (healthData && healthData.agents || []).filter(function (a) {
    if (document.getElementById('healthOnlineOnly').checked && !a.online) return false;
    if (document.getElementById('healthAlertsOnly').checked && !(a.alerts && a.alerts.length)) return false;
    if (room && (a.mesh || '(sans salle)') !== room) return false;
    return !q || [a.name, a.mesh, a.model].some(function (value) { return String(value || '').toLowerCase().indexOf(q) !== -1; });
  });
}
function refreshHealth() {
  if (healthLoading) return healthLoading;
  var button = document.getElementById('healthRefreshBtn');
  button.disabled = true;
  healthLoading = getJson(BASE + '&action=health').then(function (data) {
    if (!data || data.error || !Array.isArray(data.agents)) throw new Error(data && data.error || 'Inventaire santé invalide');
    healthData = data; healthFetchedAt = Date.now();
    var room = document.getElementById('healthRoom'), previous = room.value;
    var rooms = Array.from(new Set(data.agents.map(function (a) { return a.mesh || '(sans salle)'; }))).sort();
    stableHtml(room, '<option value="">Toutes les salles</option>' + rooms.map(function (name) { return '<option value="' + escapeHtml(name) + '">' + escapeHtml(name) + '</option>'; }).join(''));
    room.value = rooms.indexOf(previous) >= 0 ? previous : '';
    preserveMaintenanceView(renderHealth);
  }).catch(function (e) {
    document.getElementById('healthLastUpdate').textContent = 'Actualisation impossible : ' + e.message + (healthData ? ' · dernières données conservées' : '');
    if (!healthData) stableHtml(document.getElementById('healthGroups'), '<div class="empty">Erreur : ' + escapeHtml(e.message) + '</div>');
  }).then(function () { healthLoading = null; button.disabled = false; });
  return healthLoading;
}

function renderHealth() {
  if (!healthData) return;
  var filtered = filteredHealthAgents();

  // Badge sur l'onglet
  var badge = document.getElementById('healthAlertBadge');
  var total = healthData.alertCount || 0;
  if (total > 0) {
    badge.textContent = total;
    badge.className = (healthData.criticalCount > 0) ? 'alertBadge' : 'alertBadge warn';
    badge.style.display = 'inline-block';
  } else {
    badge.style.display = 'none';
  }

  // Stats en haut
  var onlineCount = healthData.agents.filter(function (a) { return a.online; }).length;
  document.getElementById('healthTotalOnline').textContent = onlineCount;
  document.getElementById('healthCritCount').textContent = healthData.criticalCount || 0;
  document.getElementById('healthWarnCount').textContent = healthData.warningCount || 0;
  var th = healthData.thresholds || {};
  document.getElementById('healthThresholds').textContent =
    'Seuils : disque < ' + th.diskWarnGB + ' Go / critique < ' + th.diskCriticalGB + ' Go · fonctionnement continu > ' + th.uptimeWarnDays + ' j / critique > ' + th.uptimeCriticalDays + ' j';
  document.getElementById('healthLastUpdate').textContent = 'Actualisé le ' + fmtBoot(healthFetchedAt);

  // Liste des alertes (en haut, condensée)
  var alertItems = [];
  filtered.forEach(function (a) {
    (a.alerts || []).forEach(function (al) {
      alertItems.push({ name: a.name, mesh: a.mesh, level: al.level, message: al.message, id: a.id });
    });
  });
  // Critiques d'abord
  alertItems.sort(function (a, b) {
    if (a.level !== b.level) return a.level === 'critical' ? -1 : 1;
    return (a.name || '').localeCompare(b.name || '', 'fr', { numeric: true });
  });
  var alertsBox = document.getElementById('healthAlertsList');
  var splitBar = document.getElementById('healthSplit');
  if (alertItems.length) {
    var nCrit = alertItems.filter(function (i) { return i.level === 'critical'; }).length;
    var nWarn = alertItems.filter(function (i) { return i.level === 'warning'; }).length;
    var headTxt = 'Alertes actives — '
      + (nCrit ? nCrit + ' critique' + (nCrit > 1 ? 's' : '') : '')
      + (nCrit && nWarn ? ' · ' : '')
      + (nWarn ? nWarn + ' avertissement' + (nWarn > 1 ? 's' : '') : '');
    var rows = alertItems.map(function (i) {
      return '<tr data-id="' + escapeHtml(i.id) + '">'
        + '<td style="width:14px"><span class="lvl ' + i.level + '" title="' + i.level + '"></span></td>'
        + '<td class="pcName">' + escapeHtml(i.name) + '</td>'
        + '<td class="salle">' + escapeHtml(i.mesh || '—') + '</td>'
        + '<td class="msg">' + escapeHtml(i.message) + '</td>'
        + '</tr>';
    }).join('');
    stableHtml(alertsBox,
      '<div class="head">' + escapeHtml(headTxt) + '</div>'
      + '<div id="healthAlertsScroll" class="body"><table>'
      + '<thead><tr><th></th><th>Poste</th><th>Salle</th><th>Détail</th></tr></thead>'
      + '<tbody>' + rows + '</tbody></table></div>');
    alertsBox.style.display = 'block';
    splitBar.style.display = 'flex';
    // Click sur une ligne → scroll/highlight la carte du poste dans la grille
    Array.prototype.forEach.call(alertsBox.querySelectorAll('tbody tr'), function (tr) {
      tr.onclick = function () {
        var pcId = tr.getAttribute('data-id');
        var card = document.querySelector('.pcCard[data-id="' + pcId + '"]');
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.style.outline = '2px solid #2c7be5';
          setTimeout(function () { card.style.outline = ''; }, 1500);
        }
      };
    });
  } else {
    stableHtml(alertsBox, '<div class="head" style="background:#e6f4ea;border-color:#b6dec0;color:#1f5b30">Aucune alerte pour les postes affichés</div>');
    alertsBox.style.display = 'block';
    splitBar.style.display = 'flex';
  }

  // Filtre + groupement par salle (mesh)
  var byMesh = {};
  filtered.forEach(function (a) {
    var k = a.mesh || '(sans salle)';
    if (!byMesh[k]) byMesh[k] = [];
    byMesh[k].push(a);
  });
  var meshNames = Object.keys(byMesh).sort(function (a, b) {
    return a.localeCompare(b, 'fr', { numeric: true });
  });
  if (!meshNames.length) {
    stableHtml(document.getElementById('healthGroups'), '<div class="empty">Aucun poste à afficher avec ces filtres.</div>');
    return;
  }
  var html = '';
  meshNames.forEach(function (m) {
    var pcs = byMesh[m];
    var crit = pcs.filter(function (p) { return (p.alerts || []).some(function (a) { return a.level === 'critical'; }); }).length;
    var warn = pcs.filter(function (p) { return (p.alerts || []).some(function (a) { return a.level === 'warning'; }); }).length;
    var sum = '';
    if (crit) sum += ' <span style="color:#c9302c">· ' + crit + ' critique' + (crit>1?'s':'') + '</span>';
    if (warn) sum += ' <span style="color:#d58512">· ' + warn + ' avertissement' + (warn>1?'s':'') + '</span>';
    html += '<div class="salleGroup"><h4>' + escapeHtml(m) + ' <span class="count">(' + pcs.length + ')</span>' + sum + '</h4>';
    html += '<div class="healthGrid">';
    pcs.forEach(function (p) {
      var worstLevel = '';
      (p.alerts || []).forEach(function (a) {
        if (a.level === 'critical') worstLevel = 'critical';
        else if (a.level === 'warning' && worstLevel !== 'critical') worstLevel = 'warning';
      });
      var cardCls = 'pcCard';
      if (!p.online) cardCls += ' offline';
      else if (worstLevel) cardCls += ' ' + worstLevel;
      var disk = p.health.diskFreeGB;
      var diskTot = p.health.diskTotalGB;
      var pct = p.health.diskFreePct;
      var diskCls = '';
      if (disk != null) {
        if (disk < (healthData.thresholds.diskCriticalGB || 2)) diskCls = 'crit';
        else if (disk < (healthData.thresholds.diskWarnGB || 10)) diskCls = 'warn';
      }
      var uptime = p.health.uptimeDays;
      var upCls = '';
      if (uptime != null) {
        if (uptime > (healthData.thresholds.uptimeCriticalDays || 45)) upCls = 'crit';
        else if (uptime > (healthData.thresholds.uptimeWarnDays || 21)) upCls = 'warn';
      }
      var fillW = (pct != null) ? Math.max(0, Math.min(100, 100 - pct)) : 0;
      var fillCls = (disk != null && disk < (healthData.thresholds.diskCriticalGB || 2)) ? 'crit'
                  : (disk != null && disk < (healthData.thresholds.diskWarnGB || 10)) ? 'warn' : '';
      html += '<div class="' + cardCls + '" data-id="' + p.id + '" title="' + escapeHtml((p.alerts||[]).map(function(a){return a.message;}).join('\n') || (p.online ? 'OK' : 'Hors ligne')) + '">'
        + '<div class="name">'
        + '<span class="statusDot ' + (p.online ? 'on' : 'off') + '"></span>'
        + escapeHtml(p.name)
        + '</div>'
        + '<div class="metric' + (diskCls ? ' ' + diskCls : '') + '"><span>Disque C:</span><span class="v">'
          + (disk != null ? (disk + '/' + diskTot + ' Go') : '—') + '</span></div>'
        + (disk != null ? '<div class="diskBar"><div class="fill ' + fillCls + '" style="width:' + fillW + '%"></div></div>' : '')
        + '<div class="metric' + (upCls ? ' ' + upCls : '') + '"><span>Sans redémarrage</span><span class="v">'
          + (uptime != null
              ? (uptime >= 1 ? (Math.round(uptime) + ' j')
                 : (Math.max(0, Math.round(uptime * 24)) + ' h'))
              : '—') + '</span></div>'
        + '<div class="metric"><span>Dernier démarrage</span><span class="v" style="font-size:11px">' + fmtBoot(p.health.lastBoot) + '</span></div>'
        + '</div>';
    });
    html += '</div></div>';
  });
  stableHtml(document.getElementById('healthGroups'), html);
}

