<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Maintenance Control</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { font-family: Segoe UI, Arial, sans-serif; font-size: 13px; padding: 10px; color: #222; box-sizing: border-box; display: flex; flex-direction: column; }
  h2 { margin: 0 0 10px 0; font-size: 16px; flex: 0 0 auto; }
  .tabs { display: flex; gap: 4px; border-bottom: 2px solid #ddd; margin-bottom: 10px; flex: 0 0 auto; }
  .tab { padding: 8px 16px; cursor: pointer; border: 1px solid transparent; border-bottom: none; border-radius: 4px 4px 0 0; font-size: 13px; color: #555; }
  .tab:hover { background: #f4f4f4; }
  .tab.active { background: #fff; border-color: #ddd; color: #2c7be5; font-weight: 600; margin-bottom: -2px; border-bottom: 2px solid #fff; }
  .panel { display: none; flex: 1 1 auto; min-height: 0; flex-direction: column; }
  .panel.active { display: flex; }
  .bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 8px; flex: 0 0 auto; }
  .bar input[type=text], .bar input[type=number], .bar select { padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  button { padding: 5px 10px; border: 1px solid #888; background: #fff; border-radius: 3px; cursor: pointer; font-size: 13px; }
  button.primary { background: #2c7be5; color: white; border-color: #2c7be5; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; background: #eee; font-size: 11px; margin-left: 6px; }
  .cols { display: flex; gap: 10px; flex: 1 1 auto; min-height: 0; }
  .col { flex: 1; border: 1px solid #ddd; border-radius: 4px; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .col.tasks { flex: 0 0 280px; }
  .col h3 { margin: 0; padding: 8px; background: #eee; border-bottom: 1px solid #ddd; font-size: 13px; flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
  .col h3 .spacer { flex: 1; }
  .col .search { padding: 6px 8px; border-bottom: 1px solid #eee; flex: 0 0 auto; }
  .col .search input { width: 100%; box-sizing: border-box; padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  .col .body { flex: 1 1 auto; overflow: auto; min-height: 0; }
  .row { padding: 5px 10px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .row:hover { background: #f8f8ff; }
  .row.selected { background: #eef6ff; }
  .row input[type=checkbox] { flex: 0 0 auto; }
  .row .main { flex: 1; }
  .row .main .title { font-weight: 500; }
  .row .main .sub { color: #888; font-size: 11px; }
  .empty { color: #aaa; font-style: italic; padding: 12px; }
  .statusDot { flex: 0 0 auto; width: 10px; height: 10px; border-radius: 50%; display: inline-block; box-shadow: 0 0 0 1px rgba(0,0,0,0.15); }
  .statusDot.on  { background: #2ecc40; }
  .statusDot.off { background: #d9534f; }
  .badge { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e2e3e5; color: #383d41; margin-right: 4px; }
  .taskGroup { padding: 8px 12px; display: flex; flex-direction: column; gap: 8px; }
  .taskGroup label { display: flex; gap: 6px; align-items: flex-start; cursor: pointer; }
  .taskGroup label .desc { color: #777; font-size: 11px; }
  .results { margin-top: 10px; border: 1px solid #ddd; border-radius: 4px; max-height: 280px; overflow: auto; flex: 0 0 auto; display: none; }
  .results table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .results th, .results td { padding: 4px 8px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; }
  .results th { background: #f4f4f4; position: sticky; top: 0; }
  .resCell { padding: 2px 6px; border-radius: 3px; font-size: 11px; display: inline-block; min-width: 50px; text-align: center; }
  .resCell.ok { background: #d4edda; color: #155724; }
  .resCell.ko { background: #f8d7da; color: #721c24; }
  .resCell.run { background: #fff3cd; color: #856404; }
  .resCell.off { background: #e2e3e5; color: #383d41; }
  /* Devices — tree view (style Gestionnaire Windows) */
  .devTree { flex: 1 1 auto; overflow: auto; border: 1px solid #ddd; border-radius: 4px; background: #fff; padding: 4px 0; font-size: 13px; }
  .devRoot { padding: 4px 6px 4px 8px; display: flex; align-items: center; gap: 6px; user-select: none; }
  .devRoot .caret { width: 10px; color: #888; font-family: monospace; }
  .devRoot .icon { width: 16px; text-align: center; }
  .devRoot .name { font-weight: 600; }
  .devRootChildren { padding-left: 22px; }
  .devClass { user-select: none; }
  .devClassHdr { padding: 4px 6px 4px 8px; cursor: pointer; display: flex; align-items: center; gap: 6px; border-radius: 3px; }
  .devClassHdr:hover { background: #f0f4ff; }
  .devClassHdr .caret { width: 10px; display: inline-block; color: #888; font-family: monospace; }
  .devClassHdr .icon { width: 16px; height: 16px; display: inline-block; flex: 0 0 16px; text-align: center; line-height: 16px; font-size: 12px; }
  .devClassHdr .name { font-weight: 500; }
  .devClassHdr .count { color: #888; font-size: 11px; margin-left: 4px; }
  .devClassHdr .badge-err { background: #f8d7da; color: #721c24; padding: 0 6px; border-radius: 8px; font-size: 11px; margin-left: 6px; }
  .devChildren { padding-left: 28px; }
  .devChildren.collapsed { display: none; }
  .devItem { padding: 3px 6px 3px 4px; display: flex; align-items: center; gap: 6px; cursor: default; border-radius: 3px; }
  .devItem:hover { background: #f4f6fa; }
  .devItem .icon { width: 16px; height: 16px; display: inline-block; flex: 0 0 16px; text-align: center; line-height: 16px; font-size: 12px; }
  .devItem .name { flex: 1 1 auto; }
  .devItem .meta { color: #888; font-size: 11px; }
  .devItem.err { background: #fff5f5; }
  .devItem.err:hover { background: #ffe9e9; }
  .devItem.disabled { color: #888; }
  .devItem.ghost { color: #aaa; font-style: italic; }
  .devItem .problem { color: #721c24; font-size: 11px; margin-left: 6px; }
  .summary { padding: 8px; background: #fff; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 8px; }
  .summary .num { font-size: 18px; font-weight: 600; margin-right: 12px; }
  .devItem { cursor: pointer; }
  /* Modal détails */
  .modalBg { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: none; align-items: center; justify-content: center; z-index: 100; }
  .modalBg.show { display: flex; }
  .modal { background: #fff; border-radius: 6px; padding: 16px; min-width: 540px; max-width: 720px; max-height: 88vh; overflow: auto; box-shadow: 0 6px 24px rgba(0,0,0,0.25); }
  .modal h3 { margin: 0 0 4px 0; font-size: 15px; display: flex; align-items: center; gap: 8px; }
  .modal .sub { color: #888; font-size: 12px; margin-bottom: 12px; }
  .modal .field { margin: 6px 0; display: flex; gap: 8px; }
  .modal .field .k { flex: 0 0 130px; color: #555; }
  .modal .field .v { flex: 1; word-break: break-all; font-family: Menlo, Consolas, monospace; font-size: 12px; }
  .modal .field .v.ids { white-space: pre-wrap; }
  .modal .probBox { padding: 8px; border-radius: 4px; background: #fff3cd; color: #856404; margin-bottom: 12px; font-size: 12px; }
  .modal .probBox.err { background: #f8d7da; color: #721c24; }
  .modal .actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; border-top: 1px solid #eee; padding-top: 12px; flex-wrap: wrap; }
  .modal .actionLeft { display: flex; gap: 8px; flex: 1; flex-wrap: wrap; }
  .modal .actionResult { margin-top: 10px; font-size: 12px; padding: 8px; border-radius: 4px; max-height: 200px; overflow: auto; white-space: pre-wrap; font-family: Menlo, Consolas, monospace; display: none; }
  .modal .actionResult.show { display: block; }
  .modal .actionResult.ok { background: #d4edda; color: #155724; }
  .modal .actionResult.ko { background: #f8d7da; color: #721c24; }
  .drvDelBtn { flex: 0 0 auto; padding: 2px 6px; border: 1px solid #ddd; background: #fff; border-radius: 3px; cursor: pointer; font-size: 13px; color: #888; }
  .drvDelBtn:hover { background: #f8d7da; color: #721c24; border-color: #f5c6cb; }
  .drvHistBtn { flex: 0 0 auto; padding: 2px 8px; margin-left: 4px; border: 1px solid #ddd; background: #fff; border-radius: 3px; cursor: pointer; font-size: 11px; color: #555; }
  .drvHistBtn:hover { background: #e7f3ff; border-color: #b6dafd; color: #0366d6; }
  .alertBadge { display: inline-block; min-width: 18px; padding: 0 6px; margin-left: 4px; border-radius: 9px; background: #d9534f; color: #fff; font-size: 11px; font-weight: 600; text-align: center; line-height: 18px; }
  .alertBadge.warn { background: #f0ad4e; }
  /* --- Santé : carte par salle --- */
  .healthBar { display: flex; gap: 12px; align-items: center; padding: 8px 12px; background: #f8f9fa; border: 1px solid #e3e6ea; border-radius: 4px; margin-bottom: 10px; flex-wrap: wrap; }
  .healthBar .stat { font-size: 13px; color: #555; }
  .healthBar .stat b { color: #222; font-size: 15px; margin-right: 4px; }
  .healthBar .stat.crit b { color: #c9302c; }
  .healthBar .stat.warn b { color: #d58512; }
  .healthAlerts { border: 1px solid #f5c6cb; background: #fff; border-radius: 4px; margin-bottom: 6px; overflow: hidden; flex: 0 0 auto; }
  .healthAlerts .head { padding: 6px 12px; background: #fdf5f5; border-bottom: 1px solid #f5c6cb; font-size: 12px; font-weight: 600; color: #721c24; }
  .healthAlerts .body { overflow: auto; height: calc(100% - 30px); }
  .healthAlerts table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .healthAlerts th { text-align: left; padding: 5px 10px; background: #fafafa; font-weight: 600; color: #555; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 1; }
  .healthAlerts td { padding: 5px 10px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
  .healthAlerts tr:last-child td { border-bottom: none; }
  .healthAlerts tr:hover td { background: #fafbfc; cursor: pointer; }
  .healthAlerts .lvl { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; }
  .healthAlerts .lvl.critical { background: #d9534f; }
  .healthAlerts .lvl.warning  { background: #f0ad4e; }
  .healthAlerts .pcName { font-weight: 600; color: #222; }
  .healthAlerts .salle { color: #888; font-size: 11px; }
  .healthAlerts .msg { color: #444; }
  .splitDrag { height: 6px; cursor: row-resize; background: transparent; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin-bottom: 6px; }
  .splitDrag::before { content: ''; display: block; width: 60px; height: 3px; background: #ccc; border-radius: 2px; }
  .splitDrag:hover::before { background: #2c7be5; }
  .salleGroup { margin-bottom: 16px; }
  .salleGroup h4 { margin: 0 0 6px 0; font-size: 13px; color: #444; padding: 4px 8px; background: #eef1f4; border-radius: 3px; display: flex; align-items: center; gap: 8px; }
  .salleGroup h4 .count { color: #888; font-weight: normal; font-size: 12px; }
  .healthGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; }
  .pcCard { border: 1px solid #ddd; border-radius: 4px; padding: 8px 10px; background: #fff; font-size: 12px; cursor: pointer; transition: box-shadow 0.1s; position: relative; }
  .pcCard:hover { box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
  .pcCard.offline { background: #f5f5f5; color: #888; }
  .pcCard.warning { border-color: #f0ad4e; border-left: 4px solid #f0ad4e; }
  .pcCard.critical { border-color: #d9534f; border-left: 4px solid #d9534f; background: #fff8f8; }
  .pcCard .name { font-weight: 600; font-size: 13px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
  .pcCard .metric { display: flex; justify-content: space-between; padding: 1px 0; color: #555; }
  .pcCard .metric .v { color: #222; }
  .pcCard .metric.crit .v { color: #c9302c; font-weight: 600; }
  .pcCard .metric.warn .v { color: #d58512; font-weight: 600; }
  .diskBar { height: 4px; background: #e3e6ea; border-radius: 2px; margin-top: 3px; overflow: hidden; }
  .diskBar .fill { height: 100%; background: #5cb85c; }
  .diskBar .fill.warn { background: #f0ad4e; }
  .diskBar .fill.crit { background: #d9534f; }
  /* --- Événements --- */
  .evtTable { width: 100%; border-collapse: collapse; font-size: 12px; }
  .evtTable th, .evtTable td { padding: 5px 8px; border-bottom: 1px solid #eee; text-align: left; vertical-align: top; }
  .evtTable th { background: #f4f4f4; position: sticky; top: 0; }
  .evtTable td.lvl { width: 70px; }
  .evtTable td.cat { width: 130px; }
  .evtTable td.time { width: 140px; white-space: nowrap; font-family: Menlo, Consolas, monospace; font-size: 11px; color: #555; }
  .evtTable td.src { width: 200px; font-family: Menlo, Consolas, monospace; font-size: 11px; color: #555; word-break: break-word; }
  .evtTable td.idCell { width: 70px; font-family: Menlo, Consolas, monospace; font-size: 11px; }
  .evtTable td.msg { font-size: 12px; }
  .evtTable tr.critical { background: #fdf5f5; }
  .evtTable tr.error { background: #fdfbf5; }
  .evtTable tr.warning { background: #fafafa; }
  .lvlBadge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 600; }
  .lvlBadge.critical { background: #d9534f; color: #fff; }
  .lvlBadge.error    { background: #f0ad4e; color: #fff; }
  .lvlBadge.warning  { background: #e2c200; color: #5c4d00; }
  .catBadge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 10px; background: #e2e3e5; color: #383d41; }
  .catBadge.bsod { background: #d9534f; color: #fff; }
  .catBadge.disk { background: #d58512; color: #fff; }
  .catBadge.driver { background: #6c757d; color: #fff; }
  .catBadge.service { background: #5bc0de; color: #fff; }
  .catBadge.network { background: #2c7be5; color: #fff; }
  .catBadge.security { background: #5cb85c; color: #fff; }
  /* --- Registre --- */
  #panel-registry { font-size: 13px; }
  #panel-registry .regMain { display: flex; flex: 1 1 auto; min-height: 0; border: 1px solid #ddd; border-radius: 4px; overflow: hidden; }
  #panel-registry .regPane { overflow: auto; }
  #panel-registry #regAgents { width: 240px; border-right: 1px solid #ddd; display: flex; flex-direction: column; background: #fafafa; }
  #panel-registry #regAgentsBar { padding: 6px; border-bottom: 1px solid #eee; display: flex; gap: 4px; align-items: center; flex: 0 0 auto; }
  #panel-registry #regAgentsBar input { flex: 1; padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 12px; }
  #panel-registry #regAgentsList { overflow: auto; flex: 1; }
  #panel-registry #regAgentsFoot { padding: 5px 8px; border-top: 1px solid #eee; font-size: 11px; color: #666; flex: 0 0 auto; }
  #panel-registry .regAg { padding: 4px 8px; border-bottom: 1px solid #f3f3f3; display: flex; align-items: center; gap: 6px; cursor: pointer; }
  #panel-registry .regAg:hover { background: #eef4fb; }
  #panel-registry .regAg.active { background: #d6e9ff; }
  #panel-registry .regAg .dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; }
  #panel-registry .regAg .dot.on { background: #2bb673; }
  #panel-registry .regAg .dot.off { background: #cd3a3a; }
  #panel-registry .regAg .name { flex: 1; font-size: 12px; }
  #panel-registry .regAg .mesh { color: #888; font-size: 10px; }
  #panel-registry #regTree { width: 34%; border-right: 1px solid #ddd; background: #fff; }
  #panel-registry #regValues { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  #panel-registry #regToolbar { padding: 6px 8px; border-bottom: 1px solid #eee; background: #f7f7f7; display: flex; gap: 6px; align-items: center; flex: 0 0 auto; }
  #panel-registry #regToolbar .path { flex: 1; padding: 2px 6px; background: #fff; border: 1px solid #ddd; border-radius: 3px; font-family: Menlo, Consolas, monospace; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #panel-registry #regValuesBody { padding: 6px; overflow: auto; flex: 1; }
  #panel-registry .regNode { padding: 1px 4px 1px 0; cursor: pointer; white-space: nowrap; font-family: Menlo, Consolas, monospace; font-size: 12px; }
  #panel-registry .regNode .twist { display: inline-block; width: 12px; color: #888; }
  #panel-registry .regNode.selected > .label { background: #d6e9ff; }
  #panel-registry .regNode .label:hover { background: #eef4fb; }
  #panel-registry .regChildren { padding-left: 14px; }
  #panel-registry .regErr { color: #b00; font-size: 11px; padding: 4px; white-space: pre-wrap; }
  #panel-registry .regTable { width: 100%; border-collapse: collapse; font-size: 12px; }
  #panel-registry .regTable th, #panel-registry .regTable td { padding: 4px 6px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; }
  #panel-registry .regTable th { background: #f4f4f4; position: sticky; top: 0; font-weight: 600; }
  #panel-registry .regTable td.data { font-family: Menlo, Consolas, monospace; word-break: break-all; max-width: 360px; }
  #panel-registry .regBadge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; background: #e2e3e5; color: #383d41; }
  #panel-registry .regBatchTag { background: #fff3cd; color: #856404; padding: 1px 6px; border-radius: 3px; font-size: 11px; }
  #panel-registry .regDanger { background: #fbe9e7; color: #8a2a17; border: 1px solid #f5c2b8; padding: 3px 8px; border-radius: 3px; cursor: pointer; }
  #panel-registry button[disabled] { opacity: 0.5; cursor: not-allowed; }
  #panel-registry .regEmpty { color: #aaa; font-style: italic; padding: 12px; text-align: center; }
  #panel-registry #regSpinner { display: none; color: #888; font-size: 11px; }
  #panel-registry #regSpinner.on { display: inline; }
  .regModalBg { position: fixed; inset: 0; background: rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; z-index: 200; }
  .regModalBg .regModal { background: #fff; padding: 16px 20px; border-radius: 6px; min-width: 460px; max-width: 90%; max-height: 90%; overflow: auto; box-shadow: 0 6px 24px rgba(0,0,0,0.25); }
  .regModalBg .regModal h3 { margin: 0 0 10px 0; font-size: 14px; }
  .regModalBg .regModal label { display: block; margin: 6px 0 2px; font-size: 12px; color: #555; }
  .regModalBg .regModal input, .regModalBg .regModal select, .regModalBg .regModal textarea { width: 100%; box-sizing: border-box; padding: 4px 6px; font-size: 12px; font-family: inherit; }
  .regModalBg .regModal textarea { font-family: Menlo, Consolas, monospace; min-height: 80px; }
  .regModalBg .regModal .actions { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
  .regBatchRes { max-height: 220px; overflow: auto; border: 1px solid #eee; padding: 6px; font-family: Menlo, Consolas, monospace; font-size: 11px; margin-top: 8px; }
  .regBatchRes .ok { color: #2bb673; }
  .regBatchRes .ko { color: #cd3a3a; }
  .regQaGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 8px 0 4px; }
  .regQaCard { display: flex; gap: 10px; align-items: center; padding: 10px 12px; border: 2px solid #e5e5e5; border-radius: 6px; cursor: pointer; background: #fff; }
  .regQaCard:hover { border-color: #999; background: #fafafa; }
  .regQaSel { padding: 6px 10px; border-radius: 4px; margin-bottom: 8px; border: 1px solid #ddd; }
  .regTone-green  { background: #e7f7ee; border-color: #b6e2c7; color: #1c6b3e; }
  .regTone-blue   { background: #e7f0fb; border-color: #b6cfe9; color: #1a4a87; }
  .regTone-orange { background: #fff4e3; border-color: #f5cfa1; color: #8a5217; }
  .regTone-red    { background: #fbe9e7; border-color: #f5b6ad; color: #8a2a17; }
  .multiLoginCard { border:1px solid #ddd; border-radius:5px; background:#fff; padding:12px; margin-bottom:10px; }
  .multiLoginCard h3 { margin:0 0 8px; font-size:14px; }
  .multiLoginOption { display:flex; gap:8px; align-items:flex-start; margin:7px 0; }
  .multiLoginOption .desc { color:#777; font-size:11px; margin-top:2px; }
  .multiLoginTable { width:100%; border-collapse:collapse; font-size:12px; }
  .multiLoginTable th, .multiLoginTable td { text-align:left; padding:5px 8px; border-bottom:1px solid #eee; vertical-align:top; }
  .multiLoginTable th { background:#f4f4f4; position:sticky; top:0; }
  .multiLoginConflict { border-left:4px solid #d9534f; background:#fff8f8; padding:8px 10px; margin-bottom:6px; }
  .multiLoginEvent { padding:4px 6px; border-bottom:1px solid #eee; font-size:11px; }
  #panel-sessions.active { display:block; overflow-y:auto; overflow-x:hidden; padding-right:2px; }
  #panel-sessions > .bar { position:sticky; top:0; z-index:5; }
  #panel-sessions .multiLoginCard { min-height:auto; overflow:visible; }
  /* Unified maintenance workspace. */
  :root { color-scheme:light; --ink:#1c2b40; --muted:#64748b; --line:#dfe6ee; --blue:#205dcc; --soft:#edf4ff; }
  * { box-sizing:border-box; }
  body { padding:18px; background:#f4f7fb; color:var(--ink); font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; min-height:640px; overflow-anchor:none; }
  button,input,select,textarea { font:inherit; }
  button { min-height:32px; border:1px solid #cbd6e3; border-radius:6px; color:var(--ink); font-weight:550; }
  button:hover { border-color:#98b4dc; background:#f3f7fc; }
  button.primary { background:var(--blue); border-color:var(--blue); }
  :focus-visible { outline:3px solid #80abfa; outline-offset:2px; }
  input[type=text],input[type=search],input[type=number],select,.bar input[type=text],.bar input[type=number],.bar select,.col .search input { padding:7px 9px; border:1px solid #cbd6e3; border-radius:6px; min-height:33px; color:var(--ink); background:#fff; }
  input[type=checkbox],input[type=radio] { accent-color:var(--blue); }
  .app-head { display:flex; align-items:center; justify-content:space-between; gap:16px; flex:0 0 auto; margin-bottom:17px; }
  .brand { display:flex; gap:12px; align-items:center; }
  .brand-mark { width:40px; height:40px; border-radius:10px; background:var(--blue); color:white; display:grid; place-items:center; flex-shrink:0; }
  .brand-mark svg { width:24px; height:24px; }
  .app-head h1 { margin:0; font-size:21px; letter-spacing:-.5px; }
  .app-head p { margin:1px 0 0; color:var(--muted); font-size:12px; }
  .workspace-state { text-align:right; font-size:12px; color:var(--muted); }
  .workspace-state span { display:block; }
  .workspace-state strong { color:var(--ink); font-weight:600; }
  .tabs { gap:5px; padding:5px; border:1px solid var(--line); border-radius:9px; background:#fff; margin-bottom:16px; flex-wrap:wrap; }
  .tab { border:0; border-radius:6px; padding:9px 15px; color:#536781; font-size:12px; }
  .tab.active { border:0; margin:0; background:var(--soft); color:var(--blue); }
  .section-intro { flex:0 0 auto; margin:0 0 12px; display:flex; justify-content:space-between; align-items:end; gap:12px; }
  .section-intro h2 { font-size:17px; margin:0 0 2px; }
  .section-intro p { color:var(--muted); font-size:12px; margin:0; }
  .bar { background:#fff; border-color:var(--line); border-radius:9px; padding:10px 12px; gap:10px; }
  .col,.devTree,.results,#evtList,.multiLoginCard,#panel-registry .regMain { border-color:var(--line); border-radius:9px; background:#fff; }
  .col h3 { padding:12px; background:#f9fbfd; border-color:var(--line); font-size:12px; }
  .col h3 button { font-size:11px; padding:3px 8px; min-height:28px; }
  .col .search { padding:10px 12px; }
  .col.tasks { flex-basis:320px; }
  .row { padding:10px 12px; border-color:#edf1f6; }
  .row:hover { background:#f7faff; }
  .row.selected { background:var(--soft); box-shadow:inset 3px 0 var(--blue); }
  .row .main .title { font-weight:600; }
  .row .main .sub { margin-top:4px; }
  .badge,.pill { border-radius:5px; background:#eef2f6; color:#596d84; }
  .statusDot { width:8px; height:8px; box-shadow:none; }
  .statusDot.on { background:#26835b; } .statusDot.off { background:#a4afbd; }
  .taskGroup { gap:0; padding:0 14px; }
  .taskGroup > label { padding:14px 0; border-bottom:1px solid #edf1f6; }
  .taskGroup label .desc { margin-top:4px; color:var(--muted); }
  .results th,.results td,.multiLoginTable th,.multiLoginTable td,.evtTable th,.evtTable td { padding:9px 11px; }
  .results th,.multiLoginTable th,.evtTable th { background:#f9fbfd; color:var(--muted); font-size:11px; }
  .empty,.regEmpty { color:var(--muted); font-style:normal; padding:22px; }
  .health-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; background:transparent; padding:0; border:0; margin-bottom:12px; flex:0 0 auto; }
  .health-stats .stat { display:flex; flex-direction:column; padding:12px 16px; border:1px solid var(--line); border-radius:9px; background:#fff; color:var(--muted); font-size:12px; }
  .health-stats .stat b { font-size:27px; line-height:1.3; color:var(--ink); margin:0 0 3px; }
  .health-stats .stat.crit b { color:#b33b50; } .health-stats .stat.warn b { color:#9b6512; }
  #healthThresholds { display:block; margin:0 0 10px; color:var(--muted); font-size:11px; flex:0 0 auto; }
  #healthSearch { flex:1 1 180px; min-width:140px; }
  #healthRoom { max-width:230px; }
  #healthLastUpdate { min-width:145px; }
  .healthAlerts { border-radius:9px; border-color:#ecd8dd; }
  .healthAlerts .head { padding:8px 12px; background:#fff7f8; }
  .healthAlerts .body { height:calc(100% - 35px); }
  .healthAlerts th,.healthAlerts td { padding:8px 12px; }
  .healthAlerts .pcName { white-space:nowrap; }
  #panel-health.active { display:block; overflow:auto; }
  #healthGroups { min-height:0; }
  #evtList { flex:1 1 auto; min-height:0; overflow:auto; }
  .healthGrid { grid-template-columns:repeat(auto-fill,minmax(205px,1fr)); gap:10px; }
  .salleGroup h4 { background:transparent; padding:8px 1px; font-size:13px; color:#43566f; }
  .pcCard { border-color:var(--line); border-radius:8px; padding:12px; }
  .pcCard .metric { padding:3px 0; font-size:11px; }
  .pcCard .name { margin-bottom:8px; }
  .diskBar { margin-bottom:5px; }
  .multiLoginCard { padding:16px; margin-bottom:12px; }
  .multiLoginCard h3 { font-size:13px; }
  .multiLoginConflict { border-radius:6px; padding:11px 13px; }
  #multiLoginEvents,#multiLoginConflictHistory { max-height:360px; overflow:auto; }
  #multiLoginSearch { flex:1 1 200px; }
  #multiLoginEditState { color:#9b6512; font-size:11px; }
  #multiLoginResetBtn { font-size:11px; }
  .rule-notice { color:#64748b; background:#f5f8fc; border-radius:6px; padding:10px; margin-top:12px; font-size:11px; }
  .modal { min-width:0; width:min(720px,calc(100vw - 32px)); border-radius:10px; padding:20px; }
  #panel-registry #regAgents { background:#f9fbfd; }
  #panel-registry #regToolbar { background:#f9fbfd; }
  @media(max-width:900px) { .col.tasks { flex-basis:285px; } .tabs { gap:2px; } .tab { padding:8px 10px; } .col h3 { flex-wrap:wrap; } }
  @media(max-width:650px) {
    body { padding:10px; height:auto; min-height:100vh; }
    .app-head { align-items:start; flex-direction:column; gap:8px; }
    .workspace-state { text-align:left; display:flex; flex-wrap:wrap; gap:2px 8px; }
    .workspace-state span { display:inline; margin-right:8px; }
    .tabs { margin-bottom:12px; } .tab { flex:1 0 30%; }
    .panel.active { min-height:450px; }
    .cols { flex-direction:column; flex:none; }
    .col { min-height:300px; flex:none; } .col.tasks { flex:auto; min-height:0; }
    .col .body { max-height:430px; }
    .health-stats { gap:7px; } .health-stats .stat { padding:10px; font-size:11px; } .health-stats .stat b { font-size:23px; }
    #panel-health.active { overflow:visible; }
    .bar select,.bar input[type=text] { min-width:0 !important; max-width:100%; }
    .bar label { max-width:100%; }
    #panel-sessions.active { overflow:visible; }
    #panel-sessions > .bar { position:static; }
    .multiLoginCard { overflow:auto !important; }
    .multiLoginCard label { min-width:0 !important; }
    #panel-registry .regMain { flex:none; min-height:500px; overflow:auto; }
    #panel-registry #regAgents { width:220px; flex:none; } #panel-registry #regTree { width:240px; flex:none; } #panel-registry #regValues { min-width:300px; }
    .regModalBg .regModal { min-width:0; width:calc(100vw - 24px); }
    .results,.devTree,#evtList { max-height:550px; min-height:180px; overflow:auto; }
  }

</style>
</head>
<body>

<header class="app-head">
  <div class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h18v13H3zM8 21h8M12 17v4M6 10h3l2-3 3 6 2-3h2"/></svg></span><div><h1>Maintenance Control</h1><p>Suivre le parc Windows et intervenir sur les postes.</p></div></div>
  <div class="workspace-state"><strong id="fleetSummary">Chargement du parc…</strong><span id="fleetStatus">Inventaire MeshCentral</span></div>
</header>
<nav class="tabs" role="tablist" aria-label="Outils de maintenance">
  <button class="tab active" id="tab-health" data-tab="health" role="tab" aria-controls="panel-health" aria-selected="true" tabindex="0">Santé du parc <span id="healthAlertBadge" class="alertBadge" style="display:none">0</span></button>
  <button class="tab" id="tab-clean" data-tab="clean" role="tab" aria-controls="panel-clean" aria-selected="false" tabindex="-1">Nettoyage</button>
  <button class="tab" id="tab-devices" data-tab="devices" role="tab" aria-controls="panel-devices" aria-selected="false" tabindex="-1">Périphériques</button>
  <button class="tab" id="tab-drivers" data-tab="drivers" role="tab" aria-controls="panel-drivers" aria-selected="false" tabindex="-1">Pilotes</button>
  <button class="tab" id="tab-events" data-tab="events" role="tab" aria-controls="panel-events" aria-selected="false" tabindex="-1">Événements</button>
  <button class="tab" id="tab-registry" data-tab="registry" role="tab" aria-controls="panel-registry" aria-selected="false" tabindex="-1">Registre</button>
  <button class="tab" id="tab-sessions" data-tab="sessions" role="tab" aria-controls="panel-sessions" aria-selected="false" tabindex="-1">Connexions</button>
</nav>

<!-- ============ TAB NETTOYAGE ============ -->
<div id="panel-clean" class="panel" role="tabpanel" aria-labelledby="tab-clean">
  <div class="section-intro"><div><h2>Nettoyer les postes</h2><p>Sélectionnez les postes et les tâches à exécuter.</p></div></div>
  <div class="bar">
    <button id="refreshBtn">Rafraîchir</button>
    <span id="selCount" class="pill">0 poste(s) sélectionné(s)</span>
    <span style="flex:1"></span>
    <button id="runBtn" class="primary" disabled>Lancer le nettoyage</button>
  </div>

  <div class="cols">
    <div class="col">
      <h3>Postes <span id="agentsCount" class="pill">0</span><span class="spacer"></span>
        <label style="font-weight:normal; font-size:11px">
          <input type="checkbox" id="onlineOnly" checked> en ligne uniquement
        </label>
        <button id="selectAllBtn">Cocher la liste</button>
        <button id="selectNoneBtn">Aucun</button>
      </h3>
      <div class="search"><input id="searchAgents" placeholder="Rechercher (nom, salle, OS, modèle)"></div>
      <div class="body" id="agentsBody"><div class="empty">Chargement…</div></div>
    </div>

    <div class="col tasks">
      <h3>Tâches de nettoyage</h3>
      <div class="taskGroup">
        <label><input type="checkbox" class="taskCheck" value="temp">
          <div>Fichiers temporaires<div class="desc">Fichiers temporaires et cache des mises à jour Windows.</div></div>
        </label>
        <label><input type="checkbox" class="taskCheck" value="browser">
          <div>Caches navigateurs<div class="desc">Chrome, Edge, Firefox</div></div>
        </label>
        <label><input type="checkbox" class="taskCheck" value="dism">
          <div>DISM / Windows.old<div class="desc">Nettoyage des composants Windows · 10 à 30 min.</div></div>
        </label>
        <label><input type="checkbox" class="taskCheck" value="profiles" id="profilesCheck">
          <div>Profils utilisateurs anciens
            <div class="desc">
              Inactifs depuis
              <input id="profileDays" type="number" value="90" min="7" max="3650" style="width:55px; font-size:11px; padding:1px 4px" onclick="event.stopPropagation()"> jours.
              Protégés : Administrator, Administrateur, admin, maintenance, comptes système.
            </div>
          </div>
        </label>
      </div>
    </div>
  </div>

  <div id="results" class="results">
    <table>
      <thead><tr>
        <th>Poste</th><th>Statut</th>
        <th>Temporaires</th><th>Navigateurs</th><th>Windows</th><th>Profils</th>
        <th>Total libéré</th>
      </tr></thead>
      <tbody id="resultsBody"></tbody>
    </table>
  </div>
</div>

<!-- ============ TAB PÉRIPHÉRIQUES ============ -->
<div id="panel-devices" class="panel" role="tabpanel" aria-labelledby="tab-devices">
  <div class="section-intro"><div><h2>Périphériques</h2><p>Inspectez le matériel et les erreurs d’un poste Windows.</p></div></div>
  <div class="bar">
    <label>Poste :
      <select id="devNodeSel" style="min-width:240px"><option value="">— sélectionner —</option></select>
    </label>
    <button id="devLoadBtn" class="primary">Charger</button>
    <button id="devRefreshBtn">Actualiser depuis le poste</button>
    <span style="flex:1"></span>
    <input id="devFilter" type="text" placeholder="Filtrer (nom, classe, statut...)" style="min-width:200px">
    <label><input type="checkbox" id="devErrorsOnly"> En erreur uniquement</label>
    <label title="CM_PROB 45 = matériel déjà vu mais pas connecté actuellement (vieilles clés USB, etc.). Masqué par défaut."><input type="checkbox" id="devShowGhosts"> Inclure absents</label>
    <label title="Affiche les classes masquées par Windows par défaut (Volumes, etc.)"><input type="checkbox" id="devShowHidden"> Afficher périphériques cachés</label>
  </div>

  <div id="devSummary" class="summary" style="display:none"></div>

  <div class="devTree" id="devListBody">
    <div class="empty">Sélectionne un poste puis clique sur "Charger".</div>
  </div>
</div>

<!-- ============ TAB DRIVERS ============ -->
<div id="panel-drivers" class="panel" role="tabpanel" aria-labelledby="tab-drivers">
  <div class="section-intro"><div><h2>Installer des pilotes</h2><p>Choisissez les postes, puis un pack de pilotes disponible.</p></div></div>
  <div class="bar">
    <button id="drvRefreshBtn">Rafraîchir</button>
    <button id="drvUploadFilesBtn" title="Sélectionne plusieurs fichiers (.inf, .sys, .cat, .dll…)">Déposer des fichiers</button>
    <button id="drvUploadZipBtn" title=".zip pré-packagé">Déposer un .zip</button>
    <input type="file" id="drvUploadFilesInput" multiple style="display:none">
    <input type="file" id="drvUploadZipInput" accept=".zip" style="display:none">
    <span id="drvUploadStatus" style="font-size:11px; color:#666"></span>
    <span id="drvSelCount" class="pill">0 poste(s) sélectionné(s)</span>
    <span style="flex:1"></span>
    <span id="drvDirInfo" style="color:#888; font-size:11px"></span>
    <button id="drvInstallBtn" class="primary" disabled>Installer le pack sélectionné</button>
  </div>

  <div class="cols">
    <div class="col">
      <h3>Postes <span id="drvAgentsCount" class="pill">0</span><span class="spacer"></span>
        <label style="font-weight:normal; font-size:11px">
          <input type="checkbox" id="drvOnlineOnly" checked> en ligne uniquement
        </label>
        <button id="drvSelectAllBtn">Cocher la liste</button>
        <button id="drvSelectNoneBtn">Aucun</button>
      </h3>
      <div class="search"><input id="drvSearchAgents" placeholder="Rechercher (nom, salle, OS, modèle)"></div>
      <div class="body" id="drvAgentsBody"><div class="empty">Chargement…</div></div>
    </div>

    <div class="col">
      <h3>Packs de pilotes <span id="drvCount" class="pill">0</span></h3>
      <div class="body" id="drvList"><div class="empty">Chargement…</div></div>
    </div>
  </div>

  <div id="drvResults" class="results">
    <table>
      <thead><tr>
        <th>Poste</th><th>Statut</th><th>Étape</th><th>Pilotes installés</th><th title="Le plugin ne redémarre JAMAIS le poste — colonne purement informative (3010 = recommandé par pnputil)">Redémarrage</th>
      </tr></thead>
      <tbody id="drvResultsBody"></tbody>
    </table>
  </div>
</div>

<!-- ============ TAB ÉVÉNEMENTS ============ -->
<div id="panel-events" class="panel" role="tabpanel" aria-labelledby="tab-events">
  <div class="section-intro"><div><h2>Événements Windows</h2><p>Retrouvez les erreurs récentes d’un poste et leur origine.</p></div></div>
  <div class="bar">
    <select id="evtNodeSel" style="min-width:240px"><option value="">— sélectionner un poste —</option></select>
    <label style="font-size:12px; color:#666">
      Derniers
      <input id="evtDays" type="number" value="7" min="1" max="30" style="width:50px"> jour(s)
    </label>
    <button id="evtLoadBtn" class="primary" disabled>Charger</button>
    <button id="evtRefreshBtn" disabled>Rafraîchir (force)</button>
    <span style="flex:1"></span>
    <span id="evtMeta" style="font-size:11px; color:#888"></span>
  </div>

  <div id="evtSummary" class="healthBar" style="display:none"></div>

  <div class="bar" id="evtFilterBar" style="display:none">
    <label style="font-size:12px; color:#666"><input type="checkbox" id="evtFiltCrit" checked> Critique</label>
    <label style="font-size:12px; color:#666"><input type="checkbox" id="evtFiltErr" checked> Erreur</label>
    <label style="font-size:12px; color:#666"><input type="checkbox" id="evtFiltWarn"> Warning</label>
    <span style="color:#ccc">|</span>
    <select id="evtFiltCat" style="font-size:12px"><option value="">Toutes catégories</option></select>
    <input id="evtFiltText" type="text" placeholder="filtrer message / source…" style="flex:1; min-width:200px; padding:3px 6px; border:1px solid #bbb; border-radius:3px">
  </div>

  <div id="evtList"><div class="empty">Sélectionne un poste puis clique sur Charger.</div></div>
</div>

<!-- ============ TAB SANTÉ ============ -->
<div id="panel-health" class="panel active" role="tabpanel" aria-labelledby="tab-health">
  <div class="section-intro"><div><h2>Santé du parc</h2><p>Repérez les alertes et consultez les postes par salle.</p></div></div>
  <div class="bar">
    <input id="healthSearch" type="search" aria-label="Rechercher un poste ou une salle" placeholder="Rechercher un poste, une salle…">
    <select id="healthRoom" aria-label="Salle"><option value="">Toutes les salles</option></select>
    <button id="healthRefreshBtn">Rafraîchir</button>
    <label style="font-size:12px; color:#666">
      <input type="checkbox" id="healthOnlineOnly" checked> Postes allumés uniquement
    </label>
    <label style="font-size:12px; color:#666">
      <input type="checkbox" id="healthAlertsOnly"> Avec alerte seulement
    </label>
    <span style="flex:1"></span>
    <span id="healthLastUpdate" style="font-size:11px; color:#888"></span>
    <span id="healthAutoInfo" style="font-size:11px; color:#888">Actualisation · 5 min</span>
  </div>

  <div class="healthBar health-stats">
    <span class="stat"><b id="healthTotalOnline">—</b>Postes en ligne</span>
    <span class="stat crit"><b id="healthCritCount">—</b>Alertes critiques</span>
    <span class="stat warn"><b id="healthWarnCount">—</b>Avertissements</span>
  </div>
  <span id="healthThresholds"></span>

  <div id="healthAlertsList" class="healthAlerts" style="display:none; height:180px"></div>
  <div id="healthSplit" class="splitDrag" style="display:none" title="Glisser pour redimensionner"></div>

  <div id="healthGroups"><div class="empty">Chargement…</div></div>
</div>

<!-- ============ TAB REGISTRE ============ -->
<div id="panel-registry" class="panel" role="tabpanel" aria-labelledby="tab-registry">
  <div class="section-intro"><div><h2>Registre Windows</h2><p>Parcourez les clés ou appliquez un modèle aux postes sélectionnés.</p></div></div>
  <div class="bar">
    <button id="regRefreshAgents">Rafraîchir postes</button>
    <button id="regRefreshTree">Recharger l'arbre</button>
    <button id="regTemplatesBtn" title="Appliquer un modèle de regkeys prédéfini">Modèles</button>
    <button id="regQuickBtn" title="Créer/écrire/supprimer à un chemin libre">Action rapide</button>
    <span id="regSpinner">⟳</span>
    <span id="regBatchTag" class="regBatchTag" style="display:none"></span>
    <span style="flex:1"></span>
    <span style="font-size:11px; color:#888">Multi-poste : coche plusieurs lignes pour batch.</span>
  </div>

  <div class="regMain">
    <div id="regAgents" class="regPane">
      <div id="regAgentsBar">
        <input id="regAgentFilter" placeholder="Filtrer…">
        <button id="regAgentSelAll" title="Tout cocher / décocher">⊞</button>
      </div>
      <div id="regAgentsList"><div class="regEmpty">Chargement…</div></div>
      <div id="regAgentsFoot"><span id="regAgentsStats">0 postes</span></div>
    </div>

    <div id="regTree" class="regPane">
      <div class="regEmpty">Clique sur un poste pour parcourir son registre.</div>
    </div>

    <div id="regValues" class="regPane" style="padding:0">
      <div id="regToolbar">
        <span class="path" id="regCurPath">—</span>
        <button id="regNewValBtn" disabled title="Ajouter une valeur">+ Valeur</button>
        <button id="regNewKeyBtn" disabled title="Créer une sous-clé">+ Sous-clé</button>
        <button id="regDelKeyBtn" class="regDanger" disabled title="Supprimer la clé">Supprimer clé</button>
      </div>
      <div id="regValuesBody">
        <div class="regEmpty">Sélectionne une clé pour voir ses valeurs.</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ TAB CONNEXIONS ============ -->
<div id="panel-sessions" class="panel" role="tabpanel" aria-labelledby="tab-sessions">
  <div class="section-intro"><div><h2>Connexions Windows</h2><p>Consultez les sessions, les conflits et leur historique.</p></div></div>
  <div class="bar">
    <button id="multiLoginRefreshBtn">Rafraîchir</button>
    <span id="multiLoginState" class="pill">Chargement…</span>
    <span id="multiLoginWatcherState" class="pill" style="display:none"></span>
    <span id="multiLoginConflictCount" class="pill" style="display:none;background:#f8d7da;color:#721c24"></span>
    <span style="flex:1"></span>
    <button id="multiLoginSaveBtn" class="primary">Enregistrer la règle</button>
  </div>

  <div class="multiLoginCard">
    <h3>Règle de connexion Windows <span id="multiLoginEditState" role="status"></span></h3>
    <button id="multiLoginResetBtn" type="button" hidden>Annuler les modifications</button>
    <label class="multiLoginOption">
      <input type="checkbox" id="multiLoginEnabled">
      <div><b>Bloquer les connexions multiples</b>
        <div class="desc">Si cette case est décochée, un même compte peut rester ouvert sur plusieurs postes.</div>
      </div>
    </label>
    <div style="margin:10px 0 6px 24px">
      <label><input type="radio" name="multiLoginMode" value="block" checked> Fermer immédiatement la nouvelle session (la salle et le poste déjà utilisés sont journalisés ci-dessous)</label><br>
      <label><input type="radio" name="multiLoginMode" value="prompt"> Proposer de fermer la session distante pour continuer sur le nouveau poste</label>
    </div>
