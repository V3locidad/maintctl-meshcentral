// ============================ ÉVÉNEMENTS ============================
var evtData = null;

function populateEvtNodeSelect() {
  var sel = document.getElementById('evtNodeSel');
  if (!sel) return;
  var prev = sel.value;
  var opts = '<option value="">— sélectionner un poste —</option>';
  agents.filter(function (a) {
    return a.online && (!a.family || a.family === 'Windows');
  }).forEach(function (a) {
    opts += '<option value="' + escapeHtml(a.id) + '">' + escapeHtml(a.name) + ' (' + escapeHtml(a.mesh || '?') + ')</option>';
  });
  sel.innerHTML = opts;
  if (prev) sel.value = prev;
  syncEvtButtons();
}

function syncEvtButtons() {
  var hasNode = !!document.getElementById('evtNodeSel').value;
  document.getElementById('evtLoadBtn').disabled = !hasNode;
  document.getElementById('evtRefreshBtn').disabled = !hasNode;
}

function loadEvents(force) {
  var nodeId = document.getElementById('evtNodeSel').value;
  if (!nodeId) return;
  var days = parseInt(document.getElementById('evtDays').value, 10) || 7;
  document.getElementById('evtList').innerHTML = '<div class="empty">Lecture des journaux Windows (jusqu\'à 3 min)…</div>';
  document.getElementById('evtSummary').style.display = 'none';
  document.getElementById('evtFilterBar').style.display = 'none';
  document.getElementById('evtMeta').textContent = '';
  var url = BASE + '&action=eventList&nodeId=' + encodeURIComponent(nodeId) + '&days=' + days + (force ? '&force=1' : '');
  getJson(url).then(function (r) {
    if (r.error) {
      document.getElementById('evtList').innerHTML = '<div class="empty">Erreur: ' + escapeHtml(r.error) + '</div>';
      return;
    }
    evtData = r;
    renderEventsSummary();
    populateEvtCatFilter();
    renderEvents();
  }).catch(function (e) {
    document.getElementById('evtList').innerHTML = '<div class="empty">Erreur: ' + escapeHtml(e.message) + '</div>';
  });
}

function renderEventsSummary() {
  if (!evtData) return;
  var s = evtData.summary || { total: 0, critical: 0, error: 0, warning: 0, byCategory: [] };
  var meta = document.getElementById('evtMeta');
  var when = evtData.lastCheck ? new Date(evtData.lastCheck).toLocaleString('fr-FR') : '';
  meta.textContent = (evtData.cached ? 'cache du ' : 'lu le ') + when;

  var box = document.getElementById('evtSummary');
  var parts = '<span class="stat"><b>' + s.total + '</b>événements</span>'
    + '<span class="stat crit"><b>' + s.critical + '</b>critiques</span>'
    + '<span class="stat"><b style="color:#d58512">' + s.error + '</b>erreurs</span>'
    + '<span class="stat"><b style="color:#5c4d00">' + s.warning + '</b>warnings</span>';
  if (s.byCategory && s.byCategory.length) {
    parts += '<span style="flex:1"></span>';
    s.byCategory.slice(0, 6).forEach(function (c) {
      if (c.critical + c.error === 0 && c.warning === 0) return;
      parts += '<span class="catBadge ' + c.cat + '" style="margin-right:4px">' + escapeHtml(c.label) + ' · ' + c.count + '</span>';
    });
  }
  box.innerHTML = parts;
  box.style.display = '';
  document.getElementById('evtFilterBar').style.display = '';
}

function populateEvtCatFilter() {
  if (!evtData) return;
  var sel = document.getElementById('evtFiltCat');
  var prev = sel.value;
  var opts = '<option value="">Toutes catégories</option>';
  (evtData.summary.byCategory || []).forEach(function (c) {
    opts += '<option value="' + c.cat + '">' + escapeHtml(c.label) + ' (' + c.count + ')</option>';
  });
  sel.innerHTML = opts;
  if (prev) sel.value = prev;
}

function fmtEvtTime(iso) {
  if (!iso) return '';
  var d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth()+1)).slice(-2) + ' '
       + ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2) + ':' + ('0' + d.getSeconds()).slice(-2);
}

function renderEvents() {
  if (!evtData) return;
  var showCrit = document.getElementById('evtFiltCrit').checked;
  var showErr = document.getElementById('evtFiltErr').checked;
  var showWarn = document.getElementById('evtFiltWarn').checked;
  var filtCat = document.getElementById('evtFiltCat').value;
  var filtText = document.getElementById('evtFiltText').value.toLowerCase().trim();

  var rows = (evtData.events || []).filter(function (e) {
    if (e.lv === 1 && !showCrit) return false;
    if (e.lv === 2 && !showErr) return false;
    if (e.lv === 3 && !showWarn) return false;
    if (filtCat && e.cat !== filtCat) return false;
    if (filtText) {
      var blob = ((e.m || '') + ' ' + (e.src || '') + ' ' + (e.id || '')).toLowerCase();
      if (blob.indexOf(filtText) < 0) return false;
    }
    return true;
  });
  // Tri par date desc
  rows.sort(function (a, b) { return (b.t || '').localeCompare(a.t || ''); });

  if (!rows.length) {
    document.getElementById('evtList').innerHTML = '<div class="empty">Aucun événement avec ces filtres.</div>';
    return;
  }
  var html = '<table class="evtTable"><thead><tr>'
    + '<th>Niveau</th><th>Catégorie</th><th>Quand</th><th>Source</th><th>ID</th><th>Message</th>'
    + '</tr></thead><tbody>';
  var lvlText = { 1: 'Critique', 2: 'Erreur', 3: 'Warning' };
  var lvlCls = { 1: 'critical', 2: 'error', 3: 'warning' };
  rows.slice(0, 500).forEach(function (e) {
    var cls = lvlCls[e.lv] || '';
    html += '<tr class="' + cls + '">'
      + '<td class="lvl"><span class="lvlBadge ' + cls + '">' + (lvlText[e.lv] || e.lv) + '</span></td>'
      + '<td class="cat"><span class="catBadge ' + (e.cat || 'other') + '">' + escapeHtml(e.catLabel || e.cat || '') + '</span></td>'
      + '<td class="time">' + escapeHtml(fmtEvtTime(e.t)) + '</td>'
      + '<td class="src">' + escapeHtml(e.src || '') + ' <span style="color:#999">[' + escapeHtml(e.l || '') + ']</span></td>'
      + '<td class="idCell">' + (e.id || '') + '</td>'
      + '<td class="msg">' + escapeHtml(e.m || '') + '</td>'
      + '</tr>';
  });
  html += '</tbody></table>';
  if (rows.length > 500) {
    html += '<div class="empty">' + (rows.length - 500) + ' événements supplémentaires non affichés (raffine les filtres).</div>';
  }
  document.getElementById('evtList').innerHTML = html;
}

document.getElementById('evtNodeSel').addEventListener('change', syncEvtButtons);
document.getElementById('evtLoadBtn').addEventListener('click', function () { loadEvents(false); });
document.getElementById('evtRefreshBtn').addEventListener('click', function () { loadEvents(true); });
document.getElementById('evtFiltCrit').addEventListener('change', renderEvents);
document.getElementById('evtFiltErr').addEventListener('change', renderEvents);
document.getElementById('evtFiltWarn').addEventListener('change', renderEvents);
document.getElementById('evtFiltCat').addEventListener('change', renderEvents);
document.getElementById('evtFiltText').addEventListener('input', renderEvents);

document.getElementById('devLoadBtn').addEventListener('click', function () { loadDevices(false); });
document.getElementById('devRefreshBtn').addEventListener('click', function () { loadDevices(true); });
document.getElementById('devFilter').addEventListener('input', renderDevices);
document.getElementById('devErrorsOnly').addEventListener('change', renderDevices);
document.getElementById('devShowGhosts').addEventListener('change', renderDevices);
